{
  "agentPushNotifEnabled": true,
  "attribution": {
    "commit": ""
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "{ printf '\\033]1337;SetUserVar=claude_state=%s\\007' 'd2FpdGluZw==' >/dev/tty; } 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "s=$(readlink \"$HOME/.claude/settings.json\" 2>/dev/null) && \"${s%/*}/../tools/refresh-claude-settings.sh\" >/dev/null 2>&1 || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "s=$(readlink \"$HOME/.claude/settings.json\" 2>/dev/null) && \"${s%/*}/../tools/refresh-claude-settings.sh\" >/dev/null 2>&1 || true",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "{ printf '\\033]1337;SetUserVar=claude_state=%s\\007' 'Y29tcGxldGU=' >/dev/tty; } 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(~/.bash_local)",
      "Read(~/.bash_password_commands)",
      "Read(~/.ssh/**)",
      "Read(**/.ssh/**)",
      "Read(**/.env*)",
      "Read(**/*password*)"
    ]
  },
  "skipAutoPermissionPrompt": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "tui": "fullscreen"
}
