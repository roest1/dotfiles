{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "s=$(readlink \"$HOME/.claude/settings.json\" 2>/dev/null) && \"${s%/*}/tab-state.sh\" waiting 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input"
      },
      {
        "hooks": [
          {
            "command": "s=$(readlink \"$HOME/.claude/settings.json\" 2>/dev/null) && \"${s%/*}/tab-state.sh\" idle 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": "idle_prompt"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "s=$(readlink \"$HOME/.claude/settings.json\" 2>/dev/null) && \"${s%/*}/tab-state.sh\" asking 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "s=$(readlink \"$HOME/.claude/settings.json\" 2>/dev/null) && \"${s%/*}/../tools/refresh-claude-settings.sh\" >/dev/null 2>&1 || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "s=$(readlink \"$HOME/.claude/settings.json\" 2>/dev/null) && \"${s%/*}/../tools/refresh-claude-settings.sh\" >/dev/null 2>&1 || true",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "s=$(readlink \"$HOME/.claude/settings.json\" 2>/dev/null) && \"${s%/*}/tab-state.sh\" stop 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "s=$(readlink \"$HOME/.claude/settings.json\" 2>/dev/null) && \"${s%/*}/tab-state.sh\" prompt 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.bash_local)",
      "Read(~/.bash_password_commands)",
      "Read(~/.ssh/**)",
      "Read(**/.ssh/**)",
      "Read(**/.env*)",
      "Read(**/*password*)"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": true,
    "enabled": true,
    "failIfUnavailable": false,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.githubusercontent.com"
      ]
    }
  }
}
