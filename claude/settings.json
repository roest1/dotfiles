{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "{ printf '\\033]1337;SetUserVar=claude_state=%s\\007' 'd2FpdGluZw==' >/dev/tty; } 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog|agent_needs_input"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "{ printf '\\033]1337;SetUserVar=claude_state=%s\\007' 'YXNraW5n' >/dev/tty; } 2>/dev/null || true",
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "s=$(readlink \"$HOME/.claude/settings.json\" 2>/dev/null) && \"${s%/*}/../tools/refresh-claude-settings.sh\" >/dev/null 2>&1 || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "s=$(readlink \"$HOME/.claude/settings.json\" 2>/dev/null) && \"${s%/*}/../tools/refresh-claude-settings.sh\" >/dev/null 2>&1 || true",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "{ n=$(jq \"(.background_tasks // []) | length\" 2>/dev/null); if [ \"${n:-0}\" -gt 0 ] 2>/dev/null; then v=YmFja2dyb3VuZA==; else v=Y29tcGxldGU=; fi; printf '\\033]1337;SetUserVar=claude_state=%s\\007' \"$v\" >/dev/tty; } 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": false,
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "deny": [
      "Read(~/.bash_local)",
      "Read(~/.bash_password_commands)",
      "Read(~/.ssh/**)",
      "Read(**/.ssh/**)",
      "Read(**/.env*)",
      "Read(**/*password*)"
    ]
  }
}
