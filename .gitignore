# Belt and braces only. These two live in $HOME — ~/.bash_local and
# ~/.bash_password_commands — outside the work tree, where git cannot see them
# at all. That is the actual protection, because it is a property rather than a
# rule: `git add -f` overrides a .gitignore entry, and rewriting this file
# silently removes one.
#
# These lines exist for the case where someone recreates them inside the repo.
# .githooks/pre-commit and a CI step both refuse them too — see
# .githooks/secret-patterns.
bash_password_commands
bash_local

# installed by `bun install --cwd nvim/lsp-servers`; bun.lock IS tracked
nvim/lsp-servers/node_modules

# Written by CI to enable Socket's install-time scanner, then removed. Never
# commit it: the scanner fails closed, so a committed bunfig.toml would make
# `make install` depend on Socket's API being reachable — see the reasoning on
# the "Scan for malicious packages" step in .github/workflows/ci.yml.
nvim/lsp-servers/bunfig.toml
