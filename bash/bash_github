#!/usr/bin/env bash
# ~/.bash_github
#
# Plain `gh` commands and the helpers shared with the TUI.
# Source this from .bashrc:
#   source ~/.bash_github
#
# Commands:
#   gha           Workflow status for HEAD
#   gha-fail      Only the failed runs
#   gha-open      Open the Actions tab in a browser
#
# THE RULE FOR THIS FILE: nothing here invokes fzf. Anything interactive
# belongs in bash_github_tui, which is sourced after this one and may use
# everything defined here. That split is what keeps the TUI deletable as a
# unit — and it is greppable (`| fzf` or a bare `fzf` call), so CI enforces
# it rather than trusting the convention. Probing for fzf with `command -v`
# is not an invocation and is fine.
#
# Dependencies: gh, jq

# ─── Portable browser open ───────────────────────────────────────
_open_url() {
  if command -v xdg-open &>/dev/null; then
    xdg-open "$1" >/dev/null 2>&1
  elif command -v open &>/dev/null; then
    open "$1"
  else
    echo "Open: $1"
  fi
}

# ─── Shared helpers ───────────────────────────────────────────────
# Used by this file and by bash_github_tui. They live here, not there,
# because the load order runs this file first — a helper defined in the
# TUI and called from here would work only by accident of when the
# prompt happens to fire.

__gh_check() {
  if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    echo "❌ Not in a git repository" >&2
    return 1
  fi
  if ! command -v gh &>/dev/null; then
    echo "❌ gh CLI not installed (make install bash)" >&2
    return 1
  fi
  if ! command -v fzf &>/dev/null; then
    echo "❌ fzf not installed (make install bash)" >&2
    return 1
  fi
}

__gh_repo() {
  gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null
}

__gh_default_branch() {
  gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null
}

# ─── Quick status ─────────────────────────────────────────────────

gha() { # gha: show most recent workflows ran
  local repo sha
  repo=$(gh repo view --json nameWithOwner -q .nameWithOwner)
  sha=$(git rev-parse HEAD)

  gh api "repos/$repo/commits/$sha/check-runs" \
    | jq -r '
      .check_runs[]
      | [
          .name,
          (if .status == "completed" then
              (if .conclusion == "success" then "✅"
               elif .conclusion == "failure" then "❌"
               elif .conclusion == "skipped" then "⏭"
               else "❓" end)
           else "⏳" end),
          .html_url
        ]
      | @tsv
    ' | while IFS=$'\t' read -r name status url; do
        printf "%-40s %s  %s\n" "$name" "$status" "$url"
      done
}

gha-fail() { # gha-fail: Failed runs
  gha | grep "❌"
}

gha-open() { # gha-open: Open github actions in browser
  local url
  url=$(gh repo view --json url -q .url)
  _open_url "$url/actions"
}
