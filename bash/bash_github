#!/usr/bin/env bash
# ~/.bash_github
#
# Plain `gh` commands and the helpers shared with the TUI.
# Source this from .bashrc:
#   source ~/.bash_github
#
# Commands:
#   gha           Workflow status for HEAD
#   stars         Your GitHub stars, grouped by List
#
# `gha` is the no-TUI one-shot: the answer on stdout without entering a
# screen. Everything else about Actions — logs, reruns, the browser tab —
# lives behind github's CI / Actions screen.
#
# It draws a table on a TTY and plain columns when piped. Rendering it is
# most of the code below, and almost all of that is width arithmetic —
# see the comments at each padding site for why printf cannot do it.
#
# THE RULE FOR THIS FILE: nothing here invokes fzf. Anything interactive
# used to belong in bash_github_tui, which was sourced after this one and
# could use everything defined here. That split is what made the TUI
# DELETABLE as a unit, and on 2026-10-24 it was deleted — `github` is a Rust
# binary (tui/github) and the 2500 lines went in one commit, leaving this
# file and `gha` untouched.
#
# The rule outlives the file it was written for. This is still the plain-gh
# file, and a screen growing back into it is the drift to catch. It is
# greppable (`| fzf` or a bare `fzf` call), so CI enforces it rather than
# trusting the convention -- a cheap guard that now holds trivially, since
# with __gh_check gone there is no mention of fzf in here at all. Probing for
# fzf with `command -v` would not be an invocation and would still be fine.
#
# Dependencies: gh, jq

# ─── Shared helpers: gone, and why ───────────────────────────────────────────
#
# `_open_url`, `__gh_check`, `__gh_repo` and `__gh_default_branch` lived here.
# The header above used to say they were "used by this file and by
# bash_github_tui"; they were only ever used by the second. When `github`
# became a Rust TUI (tui/github, 2026-10-24) all four were left with zero
# callers -- `gha` calls exactly one helper, `_gha_rule`, below.
#
# `__gh_check` is worth one more line, because by then it was also WRONG: it
# refused when fzf was missing, and nothing in this file has ever needed fzf.
# A dead guard that would have rejected a working `gha`.
#
# They are in git history, and the browser opener has a live equivalent --
# `browse()` in tui/github/src/lib.rs, the same xdg-open/open pair.


# ─── Quick status ─────────────────────────────────────────────────
#
# Uses __duration_str and __relative_time from bash_theme, which bashrc
# sources first. The github screens already depend on them the same way.

# Horizontal rule: _gha_rule <left> <mid> <right> <w>...
_gha_rule() {
  local l="$1" m="$2" r="$3"; shift 3
  local out="$l" w pad first=1
  for w in "$@"; do
    printf -v pad '%*s' "$w" ''
    (( first )) || out+="$m"
    out+="${pad// /─}"
    first=0
  done
  printf '%s%s\n' "$out" "$r"
}

gha() { # gha: workflow status for HEAD, as a table
  local repo sha rows
  repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)
  if [[ -z "$repo" ]]; then
    echo "❌ Not a GitHub repository" >&2
    return 1
  fi
  sha=$(git rev-parse HEAD 2>/dev/null) || return 1

  rows=$(gh api "repos/$repo/commits/$sha/check-runs" 2>/dev/null \
    | jq -r '
      .check_runs[]
      | [
          .name,
          (if .status == "completed" then
              (if .conclusion == "success" then "✅"
               elif .conclusion == "failure" then "❌"
               elif .conclusion == "skipped" then "⏭"
               else "❓" end)
           else "⏳" end),
          (.started_at // "-"),
          (.completed_at // "-"),
          .html_url
        ]
      | @tsv
    ')
  # The "-" sentinels above are load-bearing. Tab is an IFS *whitespace*
  # character, so `read` collapses a run of them: a genuinely empty
  # completed_at would merge two delimiters, shift html_url into $completed,
  # and leave $url empty. Emitting a placeholder keeps the fields aligned.

  if [[ -z "$rows" ]]; then
    echo "No checks reported for HEAD ($(git rev-parse --short HEAD))"
    return
  fi

  # Piped or redirected: plain TSV, no borders and no escapes. This is the
  # half of the deleted gha-fail that was worth keeping — `gha | grep ❌`
  # still works, and a table full of box-drawing characters would not.
  if [[ ! -t 1 ]]; then
    while IFS=$'\t' read -r name status started completed url; do
      printf '%s\t%s\t%s\n' "$status" "$name" "$url"
    done <<< "$rows"
    return
  fi

  local cols name_w=5 max_w
  cols=$(tput cols 2>/dev/null || echo 80)
  # Table is name_w + 24: two borders around three cells, one space of
  # padding either side of the name, plus the fixed 8 and 10 below.
  max_w=$(( cols - 24 )); (( max_w < 12 )) && max_w=12

  local name
  while IFS=$'\t' read -r name _; do
    (( ${#name} > name_w )) && name_w=${#name}
  done <<< "$rows"
  (( name_w > max_w )) && name_w=$max_w

  local dim=$'\033[38;5;240m' bold=$'\033[1m' red=$'\033[31m' off=$'\033[0m'

  # OSC 8 makes each check name a hyperlink to its job page — which is how
  # the url column earned its way out of the table without taking the link
  # with it. The sequences occupy no columns, so the padding below is still
  # measured on the bare name.
  #
  # No capability probe exists for this, and none is needed: a terminal that
  # parses OSC at all swallows a sequence it doesn't implement, so the name
  # renders plain rather than as garbage. TERM=dumb is the case that isn't
  # true of, and it is also the one where the table itself is already wrong.
  local hyper=1
  [[ "$TERM" == "dumb" || -z "$TERM" ]] && hyper=0

  printf '%s' "$dim"; _gha_rule '┌' '┬' '┐' $(( name_w + 2 )) 8 10
  printf '│%s %s%-*s%s %s│%s Status %s│%s Duration %s│%s\n' \
    "$off" "$bold" "$name_w" "Check" "$off" "$dim" "$off" "$dim" "$off" "$dim" "$off"
  printf '%s' "$dim"; _gha_rule '├' '┼' '┤' $(( name_w + 2 )) 8 10

  local status started completed url dur latest="" ok=0 bad=0 running=0 skipped=0
  while IFS=$'\t' read -r name status started completed url; do
    case "$status" in
      "✅") (( ok++ )) ;;
      "❌") (( bad++ )) ;;
      "⏳") (( running++ )) ;;
      "⏭") (( skipped++ )) ;;
    esac
    [[ "$completed" != "-" && "$completed" > "$latest" ]] && latest="$completed"

    # ASCII dash, not an em dash: printf pads %8s to a byte count, and a
    # 3-byte "—" would come out two columns narrow.
    dur="-"
    [[ "$started" != "-" && "$completed" != "-" ]] \
      && dur=$(__duration_str "$started" "$completed")

    # Truncate rather than let a long name break the border alignment.
    local shown="$name"
    (( ${#shown} > name_w )) && shown="${shown:0:name_w-1}…"

    # Pad by hand, from ${#} (characters), because printf's %-*s pads to a
    # byte count — any non-ASCII in a check name would over-pad the cell.
    local npad
    printf -v npad '%*s' $(( name_w - ${#shown} )) ''

    # Same reason, worse trap: ✅ ❌ ⏳ are East-Asian Wide (two columns) but
    # one character and three bytes, so neither %s width is right. ⏭ is
    # Neutral — one column — so it needs a space the others don't. This is
    # the same fact bash_theme's prompt encodes, where the right side adds 2
    # per emoji to its running width as it builds the string.
    local sw=2
    [[ "$status" == "⏭" ]] && sw=1
    local lpad rpad
    printf -v lpad '%*s' $(( (8 - sw) / 2 )) ''
    printf -v rpad '%*s' $(( 8 - sw - (8 - sw) / 2 )) ''

    local tint="" untint=""
    [[ "$status" == "❌" ]] && { tint="$red"; untint="$off"; }

    # The link wraps the name only, never the padding that follows it —
    # otherwise hovering underlines a run of trailing blanks out to the border.
    local link_on="" link_off=""
    if (( hyper )) && [[ -n "$url" ]]; then
      link_on=$'\033]8;;'"$url"$'\033\\'
      link_off=$'\033]8;;\033\\'
    fi

    printf '%s│%s %s%s%s%s%s%s %s│%s%s%s%s%s│%s %8s %s│%s\n' \
      "$dim" "$off" "$tint" "$link_on" "$shown" "$link_off" "$npad" "$untint" \
      "$dim" "$off" "$lpad" "$status" "$rpad" \
      "$dim" "$off" "$dur" "$dim" "$off"
  done <<< "$rows"

  printf '%s' "$dim"; _gha_rule '└' '┴' '┘' $(( name_w + 2 )) 8 10
  printf '%s' "$off"

  # Summary, in the prompt's vocabulary. Only the non-zero categories.
  # Built by concatenation rather than "${parts[*]}" with a two-space IFS:
  # [*] joins on the FIRST character of IFS, so that silently gives one.
  local summary=""
  (( ok > 0 ))      && summary+="✅ $ok passed   "
  (( bad > 0 ))     && summary+="❌ $bad failed   "
  (( running > 0 )) && summary+="⏳ $running running   "
  (( skipped > 0 )) && summary+="⏭ $skipped skipped   "
  summary="${summary%   }"

  local age=""
  [[ -n "$latest" ]] && age=$(__relative_time "$latest")

  printf '  %s%s%s%s\n' "$summary" \
    "${age:+   $dim·$off   }" "${age}" "${age:+ ago}"
}


# ─── Stars ────────────────────────────────────────────────────────
#
# Every star, and the Lists you filed them in. No cache, deliberately: a
# full fetch is 2 REST requests and 1 GraphQL point, each of 5000/hour, and
# about three seconds, and stars change whenever you click one, so a stored
# copy could only ever be the wrong answer sooner. tui/CLAUDE.md's rule agrees — only what cannot
# change is kept across sessions.
#
# Two APIs, on purpose. Stars come from REST: it returns every repo's
# topics for free, where the same fields over GraphQL measured 7-8s against
# REST's 3s (repositoryTopics alone cost ~4s). Lists come from GraphQL
# because REST has no Lists at all. There is no Repository → Lists edge in
# the schema either (only UserList.items), so "which Lists is this star in"
# is computed here, by inverting the Lists.

# _stars_fetch: stars + Lists merged into one JSON document on stdout.
_stars_fetch() {
  local tmp
  tmp=$(mktemp -d) || return 1

  # The two queries are independent, so they run at once. The subshell is
  # what keeps an interactive shell from printing "[1] 12345" and "Done" for
  # the background half: job control is off inside a subshell.
  (
    ( gh api 'user/starred?per_page=100' --paginate \
        -H 'Accept: application/vnd.github.star+json' \
        --jq '.[] | {starred_at} + (.repo | {full_name, html_url, description,
              language, topics, stargazers_count, archived, pushed_at})' \
        >"$tmp/stars" 2>"$tmp/stars.err"
      echo $? >"$tmp/stars.rc" ) &
    gh api graphql -f query='
      { viewer { lists(first: 100) {
          pageInfo { hasNextPage }
          nodes { id name slug description isPrivate
            items(first: 100) {
              pageInfo { hasNextPage }
              nodes { ... on Repository { nameWithOwner } }
            } }
      } } }' >"$tmp/lists" 2>"$tmp/lists.err"
    echo $? >"$tmp/lists.rc"
    wait
  )

  local part
  for part in stars lists; do
    if [[ "$(cat "$tmp/$part.rc" 2>/dev/null)" != 0 ]]; then
      echo "❌ fetching $part failed: $(head -c 400 "$tmp/$part.err")" >&2
      rm -rf "$tmp"
      return 1
    fi
  done

  # gh's --paginate can follow ONE connection per query, and the Lists query
  # nests two. So items past the first 100 of a List are fetched by that
  # List's id, from the start, and replace what the nested page held.
  local id names extra='{}'
  while read -r id; do
    [[ -n "$id" ]] || continue
    names=$(gh api graphql --paginate --slurp -f id="$id" -f query='
        query($id: ID!, $endCursor: String) { node(id: $id) { ... on UserList {
          items(first: 100, after: $endCursor) {
            pageInfo { hasNextPage endCursor }
            nodes { ... on Repository { nameWithOwner } }
        } } } }' 2>"$tmp/extra.err" \
      | jq -c '[.[].data.node.items.nodes[].nameWithOwner // empty]') \
      || { echo "❌ fetching a long List failed: $(head -c 400 "$tmp/extra.err")" >&2
           rm -rf "$tmp"; return 1; }
    extra=$(jq -c --arg id "$id" --argjson n "$names" '. + {($id): $n}' <<<"$extra")
  done < <(jq -r '.data.viewer.lists.nodes[] | select(.items.pageInfo.hasNextPage) | .id' "$tmp/lists")

  # 100 Lists is a GitHub-side ceiling in practice; say so rather than drop
  # the rest silently if it is ever passed.
  jq -e '.data.viewer.lists.pageInfo.hasNextPage' "$tmp/lists" >/dev/null \
    && echo "⚠ more than 100 Lists — showing the first 100" >&2

  # Descriptions are free text: tabs and newlines in them would break every
  # TSV consumer downstream, so they are flattened here, once.
  jq -n --slurpfile s "$tmp/stars" --slurpfile l "$tmp/lists" --argjson extra "$extra" '
    def clean: (. // "") | gsub("[\\t\\n\\r]+"; " ");
    ($l[0].data.viewer.lists.nodes | map({
        name, slug, description: (.description | clean), private: .isPrivate,
        repos: ($extra[.id] // [.items.nodes[].nameWithOwner // empty])
      } | . + {count: (.repos | length)})) as $lists
    | {
        fetched_at: (now | todate),
        lists: $lists,
        stars: [ $s[]
          | .full_name as $n
          | { repo: $n, url: .html_url,
              description: (.description | clean),
              language, topics: (.topics // []),
              stars: .stargazers_count, archived,
              pushed_at, starred_at,
              lists: [ $lists[] | select(any(.repos[]; . == $n)) | .name ] } ]
      }'
  local rc=$?
  rm -rf "$tmp"
  return $rc
}

stars() { # stars: your GitHub stars, grouped by List
  local mode=all want=""
  case "${1:-}" in
    --json)       mode=json ;;
    -l|--lists)   mode=lists ;;
    -h|--help)    h stars; return ;;
    -*)           echo "stars: unknown option '$1' (see: h stars)" >&2; return 2 ;;
    "")           ;;
    *)            want="$1" ;;
  esac

  local doc
  doc=$(_stars_fetch) || return 1

  if [[ "$mode" == json ]]; then
    jq . <<<"$doc"
    return
  fi

  local dim=$'\033[38;5;240m' bold=$'\033[1m' off=$'\033[0m'
  local tty=0; [[ -t 1 ]] && tty=1

  if [[ "$mode" == lists ]]; then
    # "-" for an empty description: tab is IFS whitespace, so `read` would
    # collapse an empty field and shift the next one left (see gha).
    local rows name count desc
    rows=$(jq -r '
      (.lists[] | [.name, (.count | tostring), (if .description == "" then "-" else .description end)]),
      ["Unlisted", ([.stars[] | select(.lists == [])] | length | tostring), "starred, in no List"]
      | @tsv' <<<"$doc")
    if (( ! tty )); then
      printf '%s\n' "$rows"
      return
    fi
    local name_w=0
    while IFS=$'\t' read -r name _; do
      (( ${#name} > name_w )) && name_w=${#name}
    done <<< "$rows"
    while IFS=$'\t' read -r name count desc; do
      [[ "$desc" == "-" ]] && desc=""
      printf '  %s%-*s%s %s%4s%s  %s\n' "$bold" "$name_w" "$name" "$off" "$dim" "$count" "$off" "$desc"
    done <<< "$rows"
    return
  fi

  # A List is named by its name or its slug, any case; "unlisted" is the
  # stars in none. Resolved to the exact name once, so the filters below
  # compare names and nothing else.
  if [[ -n "$want" ]]; then
    local resolved
    resolved=$(jq -r --arg w "${want,,}" '
      if $w == "unlisted" then "Unlisted"
      else first(.lists[] | select((.name | ascii_downcase) == $w or .slug == $w) | .name) // empty
      end' <<<"$doc")
    if [[ -z "$resolved" ]]; then
      echo "stars: no List named '$want'. Lists: $(jq -r '[.lists[].name] + ["Unlisted"] | join(", ")' <<<"$doc")" >&2
      return 1
    fi
    want="$resolved"
  fi

  # Piped: one star per row — repo, Lists, language, description — so
  # `stars | grep -i rust` and `stars | cut -f1` work without the layout.
  if (( ! tty )); then
    jq -r --arg w "$want" '
      .stars[]
      | select($w == "" or ($w == "Unlisted" and .lists == []) or any(.lists[]; . == $w))
      | [.repo,
         (if .lists == [] then "-" else (.lists | join(", ")) end),
         (.language // "-"),
         (if .description == "" then "-" else .description end)]
      | @tsv' <<<"$doc"
    return
  fi

  # On a terminal: one block per List, in GitHub's order, then Unlisted.
  # A star in three Lists appears three times — that IS the organization.
  local rows
  rows=$(jq -r --arg w "$want" '
    (.stars | map({key: .repo, value: .}) | from_entries) as $by
    | (.lists + [{name: "Unlisted", description: "starred, in no List",
                  repos: [.stars[] | select(.lists == []) | .repo]}])[]
    | select($w == "" or .name == $w)
    | select(.repos != [])
    | (["H", .name, (.repos | length | tostring),
        (if .description == "" then "-" else .description end)] | @tsv),
      (.repos[] as $n
        | ($by[$n] // {repo: $n, url: ("https://github.com/" + $n), description: "", language: null})
        | ["R", .repo, .url, (.language // "-"),
           (if .description == "" then "-" else .description end)] | @tsv)' <<<"$doc")

  if [[ -z "$rows" ]]; then
    echo "No stars in $want"
    return
  fi

  local cols kind a b c d repo_w=0 lang_w=0
  cols=$(tput cols 2>/dev/null || echo 80)
  while IFS=$'\t' read -r kind a b c _; do
    [[ "$kind" == R ]] || continue
    (( ${#a} > repo_w )) && repo_w=${#a}
    [[ "$c" != "-" ]] && (( ${#c} > lang_w )) && lang_w=${#c}
  done <<< "$rows"
  (( repo_w > 40 )) && repo_w=40

  # Same OSC 8 links as gha: the repo name opens the repo (ctrl-click in
  # wezterm), and TERM=dumb is the one place to leave them out.
  local hyper=1
  [[ "$TERM" == "dumb" || -z "$TERM" ]] && hyper=0

  local first=1 shown pad lpad room link_on link_off
  # Two-space indent and two-space gutters around the language column.
  room=$(( cols - 2 - repo_w - 2 - lang_w - 2 ))
  while IFS=$'\t' read -r kind a b c d; do
    if [[ "$kind" == H ]]; then
      (( first )) || echo
      first=0
      [[ "$c" == "-" ]] && c=""
      printf '%s%s%s %s(%s)%s%s\n' "$bold" "$a" "$off" "$dim" "$b" "$off" "${c:+  $dim$c$off}"
      continue
    fi
    shown="$a"
    (( ${#shown} > repo_w )) && shown="${shown:0:repo_w-1}…"
    # Padded by hand from ${#}: printf's %-*s counts bytes (see gha).
    printf -v pad '%*s' $(( repo_w - ${#shown} )) ''
    [[ "$c" == "-" ]] && c=""
    printf -v lpad '%*s' $(( lang_w - ${#c} )) ''
    [[ "$d" == "-" ]] && d=""
    (( room > 1 && ${#d} > room )) && d="${d:0:room-1}…"
    (( room <= 1 )) && d=""
    link_on="" link_off=""
    if (( hyper )); then
      link_on=$'\033]8;;'"$b"$'\033\\'
      link_off=$'\033]8;;\033\\'
    fi
    printf '  %s%s%s%s  %s%s%s%s  %s\n' \
      "$link_on" "$shown" "$link_off" "$pad" "$dim" "$c" "$lpad" "$off" "$d"
  done <<< "$rows"

  if [[ -z "$want" ]]; then
    printf '\n%s%s%s\n' "$dim" "$(jq -r '"\(.stars | length) stars · \(.lists | length) Lists · \([.stars[] | select(.lists == [])] | length) unlisted"' <<<"$doc")" "$off"
  fi
}
