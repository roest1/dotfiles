#!/usr/bin/env bash
# ~/.bash_theme
#####################################################################
# Bash Theme — colours for ls, eza, grep, man, git and gcc (Ayu palette)
#
# The prompt is not here. It is roest1/PS1, a submodule at ps1/, linked
# to ~/.bash_prompt by deps.conf and sourced by bashrc.
#####################################################################

# ─── LS_COLORS (Ayu palette) ──────────────────────────────────────
export LS_COLORS="\
di=1;38;5;75:\
ln=38;5;110:\
so=38;5;141:\
pi=38;5;141:\
ex=38;5;150:\
bd=38;5;215:\
cd=38;5;215:\
su=38;5;203:\
sg=38;5;203:\
tw=38;5;214:\
ow=38;5;214:\
*.py=38;5;214:\
*.lua=38;5;75:\
*.js=38;5;215:\
*.ts=38;5;215:\
*.jsx=38;5;215:\
*.tsx=38;5;215:\
*.cs=38;5;75:\
*.json=38;5;180:\
*.yaml=38;5;180:\
*.yml=38;5;180:\
*.toml=38;5;180:\
*.md=38;5;110:\
*.sh=38;5;150:\
*.bash=38;5;150:\
*.css=38;5;110:\
*.html=38;5;203:\
*.sql=38;5;75:\
*.xml=38;5;110:\
*.gitignore=38;5;243:\
*.env=38;5;243:\
*.log=38;5;243:\
*.tar=38;5;203:\
*.gz=38;5;203:\
*.zip=38;5;203:\
*.7z=38;5;203:\
"
export EZA_COLORS="$LS_COLORS"

# ─── Grep colors ──────────────────────────────────────────────────
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

# ─── Man page colors ──────────────────────────────────────────────
export LESS='-R'
export LESS_TERMCAP_mb=$'\e[38;5;203m'
export LESS_TERMCAP_md=$'\e[38;5;75m'
export LESS_TERMCAP_me=$'\e[0m'
export LESS_TERMCAP_so=$'\e[38;5;215;48;5;236m'
export LESS_TERMCAP_se=$'\e[0m'
export LESS_TERMCAP_us=$'\e[38;5;110m'
export LESS_TERMCAP_ue=$'\e[0m'

# ─── Git / GCC ────────────────────────────────────────────────────
export GIT_PAGER='less -FRX'
export GCC_COLORS='error=01;38;5;203:warning=01;38;5;215:note=01;38;5;110:caret=01;38;5;75:locus=01:quote=01'

#####################################################################
# End Theme
#####################################################################
