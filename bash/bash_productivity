#!/usr/bin/env bash
# ~/.bash_productivity
#
# Source this from .bashrc:
#   source ~/.bash_productivity
#
# Prerequisites (install once):
#   brew install zoxide fzf bat eza
#
# See all custom commands:
#   h           Show quick reference
#   h <command> Show detailed help for a command
#
#   TODO:
#   use cloc: https://github.com/AlDanial/cloc

# ─── Dependencies ──────────────────────────────────────────────────────

# ─── zoxide (smarter cd) ──────────────────────────────────────────────────────
if command -v zoxide &>/dev/null; then
  eval "$(zoxide init bash)"
fi

# ─── fzf (fuzzy everything) ───────────────────────────────────────────────────
if command -v fzf &>/dev/null; then
  eval "$(fzf --bash 2>/dev/null)" || source /usr/share/bash-completion/completions/fzf 2>/dev/null
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
  _fd=""
  command -v fd &>/dev/null && _fd=fd
  command -v fdfind &>/dev/null && _fd=fdfind
  if [[ -n "$_fd" ]]; then
    export FZF_DEFAULT_COMMAND="$_fd --type f --hidden --exclude .git"
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
    export FZF_ALT_C_COMMAND="$_fd --type d --hidden --exclude .git"
  fi
  unset _fd
fi

# ─── The two fzf shapes ───────────────────────────────────────────────────────
#
# Every interactive screen in this repo is one of two things, and the
# difference is whether typing filters or acts:
#
#   menu   a fixed set of choices. --disabled turns the query off, so plain
#          keys are commands: q and - go back, like nvim.
#   list   an open set to search. Typing filters, esc goes back.
#
# The keybindings and the header hint live HERE, once, rather than at each
# call site. They were previously repeated at 18 of them — identical strings
# that had to be kept identical by hand, which is not a convention so much as
# an ongoing opportunity to drift. Adding a key to the menu contract is now
# one edit, and CI checks that no screen hand-rolls its own.
#
# Chrome (height, layout, border) is FZF_DEFAULT_OPTS above and applies to
# Ctrl+R and Ctrl+T too. The binds deliberately are NOT there: --disabled is
# what makes q mean "quit" rather than the letter q, and forcing that globally
# would break typing the letter q into history search.
#
# Both read choices on stdin. Pass extra fzf flags after the title:
#   printf '%s\n' a b c | __fzf_menu "Pick one" --height=5
#
# Three optional variables, each set for a single call rather than exported.
# They live here so a screen cannot invent its own spelling of the same idea:
#
#   FZF_MENU_BACK   last word of the hint, for a top-level screen that exits
#                   rather than returns:
#                     FZF_MENU_BACK=exit __fzf_menu "GitHub — $repo"
#
#   FZF_MENU_HELP   path to a file shown by `?`. The binding and the ` ?help`
#                   hint appear together, so a screen cannot advertise help it
#                   doesn't have or have help nobody can find:
#                     FZF_MENU_HELP="$f" __fzf_menu "Pull Requests"
#
#   FZF_MENU_EXPECT comma-separated keys that should end the menu and report
#                   themselves. Output becomes two lines — the key (empty for a
#                   plain enter) then the selection — so only call sites that
#                   set it need to handle that. gh-tui uses it for `r`, which
#                   nothing else needs and which the pagers already spell the
#                   same way.
__fzf_menu() {
  local title="$1"; shift
  local binds='q:abort,-:abort'
  local hint="↑↓ nav  enter select  -/q ${FZF_MENU_BACK:-back}"
  local -a extra=()

  if [[ -n "$FZF_MENU_HELP" && -f "$FZF_MENU_HELP" ]]; then
    # execute() hands fzf's terminal to less and returns to the menu after,
    # which is what makes ? feel like a peek rather than an exit.
    binds+=",?:execute(less -R -- '$FZF_MENU_HELP')"
    hint+="  ?help"
  fi
  [[ -n "$FZF_MENU_EXPECT" ]] && extra+=(--expect="$FZF_MENU_EXPECT")

  fzf --disabled --bind "$binds" \
      --header="${title}  │  ${hint}" \
      --no-info "${extra[@]}" "$@"
}

# FZF_LIST_HINT replaces the middle of the hint for lists whose enter key does
# something more specific than "select" — viewing a diff, opening an action
# menu. The trailing `esc back` is not overridable: that is the half of the
# contract that must be identical everywhere.
__fzf_list() {
  local title="$1"; shift
  fzf --header="${title}  │  ${FZF_LIST_HINT:-type to filter  enter select}  esc back" "$@"
}

# eza: modern ls replacement with git integration and icons.
if command -v eza &>/dev/null; then
  alias ls='eza --icons --group-directories-first'
  alias ll='eza -la --icons --group-directories-first --git'
  alias lt='eza -la --icons --tree --level=2 --git-ignore'
else
  alias ll='ls -alFh'
fi

# bat: cat with syntax highlighting and line numbers.
# On Debian/Ubuntu, bat installs as `batcat` due to a name conflict.
if command -v bat &>/dev/null; then
  alias cat='bat --plain --paging=never'
  alias catn='bat'
elif command -v batcat &>/dev/null; then
  alias cat='batcat --plain --paging=never'
  alias catn='batcat'
fi

# clear: the screen, and only the screen.
#
# /usr/bin/clear sends \E[H\E[2J\E[3J. The first two home the cursor and
# erase the display; the third is E3, "erase saved lines", which does not
# clear the screen at all — it discards the terminal's entire scrollback
# (Windows Terminal keeps 9001 lines by default, wezterm 3500).
#
# Ctrl-L has never done that. Readline's clear-screen uses the terminfo
# `clear` capability, which is \E[H\E[2J with no E3 — the third sequence
# comes from the clear *binary*, not the terminal database. So the command
# and the keystroke used to disagree about whether your history survives,
# and now they don't.
#
# The measured win is the fork: ~500us for the binary against ~30us for
# the builtin. Whether E3 also costs the terminal real repaint time is
# NOT established — `time clear` can't answer it, because it times the
# write() to the pty and the terminal repaints asynchronously afterwards.
# Keeping the scrollback is the point; the microseconds are a bonus.
#
# Any argument is forwarded to the real binary, so `clear -x` and friends
# still work, and `command clear` still discards the scrollback on purpose.
# shellcheck disable=SC2120  # args come from the user at a prompt, not a call site
clear() {
  if (( $# )); then
    command clear "$@"
  else
    printf '\033[H\033[2J'
  fi
}

# ─── Navigation ──────────────────────────────────────────────────────

# mkcd: create directory and cd into it in one step
mkcd() {
  # `|| return` matters: without it a failed cd (permissions, a path component
  # that exists as a file) still returns success, so `mkcd x && setup` would
  # run setup in the wrong directory.
  mkdir -p "$1" && cd "$1" || return
}

# back: go up N directories. `back 3` = cd ../../..
back() {
  local d=""
  for ((i = 1; i <= ${1:-1}; i++)); do
    d="../$d"
  done
  cd "$d" || return
}

# downloads: cd to the Windows Downloads folder, from inside WSL.
#
# This is in the repo rather than in ~/.bash_local because nothing about it is
# machine-specific — the path is *derived*, never written down. Hardcoding
# /mnt/c/Users/<you>/Downloads would be a per-machine fact and would belong in
# bash_local; asking Windows where its own Downloads folder is, is not.
#
# Three things it does not assume:
#
#   The username. /mnt/c/Users on this machine contains both `Riley` and
#   `Riley Oest`, so globbing for a likely-looking directory picks wrong. The
#   registry is the only unambiguous answer.
#
#   That Downloads is under %USERPROFILE%. OneDrive relocates the known folder,
#   and after that `$USERPROFILE\Downloads` is either stale or absent. The
#   Shell Folders key tracks the move; it is queried rather than guessed. (Use
#   "Shell Folders", not "User Shell Folders" — the latter returns unexpanded
#   %USERPROFILE% strings.)
#
#   The C: mount point. `wslpath -u 'C:\Windows\System32'` resolves it, so a
#   non-default `root=` in /etc/wsl.conf still works. Absolute paths to the
#   .exe files are needed because appendWindowsPath=false is a common setting
#   and is the case here — cmd.exe is not on PATH.
#
# The lookup is ~30ms and runs on first use only, never at shell startup.
# WIN_DOWNLOADS doubles as the cache and as the override: set it in
# ~/.bash_local and detection is skipped entirely.
downloads() {
  if [[ -z "$WIN_DOWNLOADS" ]]; then
    grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null || {
      echo "downloads: only meaningful under WSL" >&2
      return 1
    }

    local sys win
    sys=$(wslpath -u 'C:\Windows\System32' 2>/dev/null)

    # {374DE290-...} is the Downloads known-folder GUID.
    win=$("$sys/reg.exe" query \
            'HKCU\Software\Microsoft\Windows\CurrentVersion\Explorer\Shell Folders' \
            /v '{374DE290-123F-4565-9164-39C4925E467B}' 2>/dev/null \
          | tr -d '\r' | awk '/REG_SZ/ { sub(/.*REG_SZ[[:space:]]+/, ""); print }')

    # Key missing or renamed: fall back to the default location.
    [[ -z "$win" ]] && win=$("$sys/cmd.exe" /c 'echo %USERPROFILE%\Downloads' 2>/dev/null | tr -d '\r')

    [[ -n "$win" ]] && WIN_DOWNLOADS=$(wslpath -u "$win" 2>/dev/null)
  fi

  [[ -d "$WIN_DOWNLOADS" ]] || {
    echo "downloads: couldn't locate the Windows Downloads folder" >&2
    echo "  set WIN_DOWNLOADS in ~/.bash_local to point at it" >&2
    return 1
  }
  cd "$WIN_DOWNLOADS" || return
}

# ─── Process management ──────────────────────────────────────────────────────

# port: show what's running on a given port.
# Uses lsof first (macOS/Linux), falls back to ss (Linux).
port() {
  lsof -i :"$1" 2>/dev/null || ss -tlnp | grep ":$1"
}

# ─── Misc power tools ────────────────────────────────────────────────────────

# serve: quick HTTP server in current directory
# Depends on: python3 # Maybe change this to uv? # This doesn't ever come into my workflow though
serve() {
  local port="${1:-8000}"
  echo "Serving on http://localhost:${port}"
  python3 -m http.server "$port"
}

# loop: repeatedly run a command with a clear screen (like watch)
# Usage: loop ls -la    (refreshes every 2s)
#        LOOP_INTERVAL=5 loop df -h
#        loop 'df -h | grep sda'
loop() {
  while true; do
    clear
    echo "─── $(date) ───"
    # eval is deliberate and stays. Running "$@" directly would be safer, but
    # it would also drop the third usage above: a pipeline passed as one
    # string is the main reason to reach for a watch-alike, and `"$@"` would
    # try to exec a command literally named `df -h | grep sda`.
    # shellcheck disable=SC2294
    eval "$@"
    sleep "${LOOP_INTERVAL:-2}"
  done
}

# findword: rg all occurences
# I have used this a bit in the past and it was quite useful, but don't know if it should be replaced or 
# consolidated by fzf -- rg is an optimization I should always be using over grep 
findword() {
    local search_term="$1"
    shift
    local ignore_dirs=""

    # Professional argument parsing for the -I flag
    while [[ "$#" -gt 0 ]]; do
        case $1 in
            -I) ignore_dirs="$2"; shift ;;
            *) echo "Unknown parameter: $1"; return 1 ;;
        esac
        shift
    done

    if [ -z "$search_term" ]; then
        echo "Usage: findword <search_string> [-I 'dir1|dir2']"
        return 1
    fi

    # Initialize the command array to avoid shell expansion issues
    local rg_args=(
        --column
        --line-number
        --no-heading
        --color=always
        --smart-case
        --word-regexp # This is the same as \b...\b but cleaner
        --hidden
    )

    # Standard excludes
    for pattern in ".git" "node_modules" "bin" "obj"; do
        rg_args+=(--glob "!**/$pattern/*")
    done

    # Custom excludes from the -I flag
    if [ -n "$ignore_dirs" ]; then
        IFS='|' read -ra DIRS <<< "$ignore_dirs"
        for dir in "${DIRS[@]}"; do
            # We use !**/$dir/** to prune the directory tree entirely
            rg_args+=(--glob "!**/$dir/**")
        done
    fi

    # Final execution
    rg "${rg_args[@]}" "$search_term"
}

# extract: Universal archive extractor
#
# The xz and zstd cases pipe through the decompressor rather than using tar's
# own -J / --zstd. Both spellings are GNU-tar-isms that bsdtar either lacks or
# spells differently, and macOS is CI-tested only — a decompressor writing to
# `tar xf -` is the construct that works on every tar we claim to support.
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)   tar xjf "$1"     ;;
            *.tar.gz)    tar xzf "$1"     ;;
            *.tar.xz)    xz -dc "$1"    | tar xf - ;;
            *.tar.zst)   zstd -dc "$1"  | tar xf - ;;
            *.txz)       xz -dc "$1"    | tar xf - ;;
            *.tzst)      zstd -dc "$1"  | tar xf - ;;
            *.bz2)       bunzip2 "$1"     ;;
            *.rar)       unrar x "$1"     ;;
            *.gz)        gunzip "$1"      ;;
            *.xz)        unxz "$1"        ;;
            *.zst)       unzstd "$1"      ;;
            *.tar)       tar xf "$1"      ;;
            *.tbz2)      tar xjf "$1"     ;;
            *.tgz)       tar xzf "$1"     ;;
            *.zip)       unzip "$1"       ;;
            *.Z)         uncompress "$1"  ;;
            *.7z)        7z x "$1"        ;;
            *)           echo "'$1' cannot be extracted via extract()" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# ─── compress — the inverse of extract ──────────────────────────────────────
#
#   compress backup.tar.zst src/        compress -9 dist.tar.xz build/
#   compress notes.gz notes.txt         compress out.zip a/ b/ c.txt
#
# extract's virtue is that the *input* name picks the format and there are no
# flags to remember. This inverts that literally: the *output* name picks the
# format. The only flags are a level and -f, and both are optional.
#
# Defaults are chosen from measurement, not convention (12M CSV, 128 cores):
#
#     gzip -6      342ms → 4.7M      zstd -3       54ms → 4.5M
#     gzip -9      418ms → 4.7M      zstd -19    4374ms → 3.9M
#     pigz -9       33ms → 4.7M      xz -9e -T0  5770ms → 3.7M
#
# Three things follow. `gzip -9` is a trap — 22% slower than -6 for a rounding
# error in size, so gz defaults to 6, not 9. zstd -3 beats gzip -9 on *both*
# axes, which is why .tar.zst is the format to reach for. And -19 costs 80x the
# time for 13%, so a max level is strictly opt-in and never a default.
#
# Parallelism comes from `-T0` and from pigz/pbzip2 rather than from counting
# cores here: every one of those spellings means "all of them" already, so
# there is no nproc/sysctl split to get wrong on macOS.
#
# The tar path pipes (`tar -cf - | filter`) instead of using tar's -z/-j/-J/
# --zstd. Same reason as extract above: the pipe is the portable construct, and
# it is also the only one that gets threading, since tar's built-in shorthands
# invoke the single-threaded compressor.
_compress_filter() {
    local fmt="$1" lvl="$2"
    COMPRESS_CMD=()
    case "$fmt" in
        gz)
            if command -v pigz >/dev/null 2>&1; then COMPRESS_CMD=(pigz "-${lvl:-6}")
            else COMPRESS_CMD=(gzip "-${lvl:-6}" -c); fi ;;
        zst)
            command -v zstd >/dev/null 2>&1 || return 1
            COMPRESS_CMD=(zstd "-${lvl:-3}" -T0 -q -c) ;;
        xz)
            command -v xz >/dev/null 2>&1 || return 1
            COMPRESS_CMD=(xz "-${lvl:-6}" -T0 -c) ;;
        bz2)
            if command -v pbzip2 >/dev/null 2>&1; then COMPRESS_CMD=(pbzip2 "-${lvl:-9}" -c)
            elif command -v bzip2 >/dev/null 2>&1; then COMPRESS_CMD=(bzip2 "-${lvl:-9}" -c)
            else return 1; fi ;;
        *) return 1 ;;
    esac
    return 0
}

compress() {
    local out="" force=0 level="" fmt="" tarred=0 rc=0
    local -a inputs

    while [ $# -gt 0 ]; do
        case "$1" in
            -f)                 force=1; shift ;;
            -[0-9]|-[0-9][0-9]) level="${1#-}"; shift ;;
            -h|--help)          h compress; return 0 ;;
            --)                 shift; break ;;
            -*) echo "compress: unknown flag '$1'" >&2; return 2 ;;
            *)  break ;;
        esac
    done

    out="$1"; [ $# -gt 0 ] && shift
    inputs=("$@")

    if [ -z "$out" ] || [ ${#inputs[@]} -eq 0 ]; then
        echo "usage: compress [-<level>] [-f] <archive> <path>..." >&2
        echo "       format comes from the archive name (.tar.zst, .zip, .gz, ...)" >&2
        return 2
    fi
    if [ -e "$out" ] && [ $force -eq 0 ]; then
        echo "compress: $out exists (use -f to overwrite)" >&2; return 1
    fi

    local p
    for p in "${inputs[@]}"; do
        [ -e "$p" ] || { echo "compress: no such file or directory: $p" >&2; return 1; }
    done

    case "$out" in
        *.tar.gz|*.tgz)   fmt=gz;  tarred=1 ;;
        *.tar.bz2|*.tbz2) fmt=bz2; tarred=1 ;;
        *.tar.xz|*.txz)   fmt=xz;  tarred=1 ;;
        *.tar.zst|*.tzst) fmt=zst; tarred=1 ;;
        *.tar)            fmt=tar; tarred=1 ;;
        *.zip)            fmt=zip ;;
        *.7z)             fmt=7z  ;;
        *.gz)             fmt=gz  ;;
        *.bz2)            fmt=bz2 ;;
        *.xz)             fmt=xz  ;;
        *.zst)            fmt=zst ;;
        *) echo "compress: don't know how to build '$out'" >&2
           echo "          known: .tar.gz .tar.bz2 .tar.xz .tar.zst .tar .zip .7z .gz .bz2 .xz .zst" >&2
           return 2 ;;
    esac

    # A bare single-file format has nowhere to put a second member, and no
    # directory structure to record. Say so rather than silently archiving
    # only the first argument.
    if [ $tarred -eq 0 ] && [ "$fmt" != zip ] && [ "$fmt" != 7z ]; then
        if [ ${#inputs[@]} -ne 1 ] || [ -d "${inputs[0]}" ]; then
            echo "compress: .$fmt takes exactly one file — use .tar.$fmt for directories or multiple inputs" >&2
            return 2
        fi
    fi

    case "$fmt" in
        zip)
            command -v zip >/dev/null 2>&1 || { echo "compress: zip not installed" >&2; return 1; }
            zip -r -q "-${level:-6}" "$out" "${inputs[@]}" || rc=$?
            ;;
        7z)
            command -v 7z >/dev/null 2>&1 || { echo "compress: 7z not installed" >&2; return 1; }
            7z a -bso0 -bsp0 "$out" "${inputs[@]}" >/dev/null || rc=$?
            ;;
        tar)
            COPYFILE_DISABLE=1 tar -cf "$out" -- "${inputs[@]}" || rc=$?
            ;;
        *)
            _compress_filter "$fmt" "$level" || {
                echo "compress: no compressor available for .$fmt" >&2; return 1; }
            if [ $tarred -eq 1 ]; then
                # COPYFILE_DISABLE stops macOS tar emitting a ._ AppleDouble
                # sidecar for every file, which the Linux side then unpacks as
                # litter. Harmless no-op on GNU tar.
                COPYFILE_DISABLE=1 tar -cf - -- "${inputs[@]}" | "${COMPRESS_CMD[@]}" > "$out"
            else
                "${COMPRESS_CMD[@]}" < "${inputs[0]}" > "$out"
            fi
            # bash 3.2 has no `set -o pipefail` worth toggling inside an
            # interactive function — PIPESTATUS answers the same question
            # without leaving the option set behind us.
            for p in "${PIPESTATUS[@]}"; do [ "$p" -eq 0 ] || rc=$p; done
            ;;
    esac

    if [ "$rc" -ne 0 ]; then
        rm -f "$out"          # never leave a truncated archive that looks real
        echo "compress: failed building $out" >&2
        return "$rc"
    fi

    if command -v du >/dev/null 2>&1; then
        echo "$out ($(du -h "$out" | cut -f1))"
    else
        echo "$out"
    fi
}

# ─── 2csv / 2txt / 2xlsx — spreadsheet conversion ────────────────────────────
#
#   2csv  report.xlsx      2txt  report.xlsx      2xlsx  old.xls
#
# Reads xlsx, xlsm, xlsb, legacy BIFF .xls, ods, csv and tsv. One engine
# handles all of it: qsv, which wraps the calamine parser. No Excel, no
# LibreOffice, no Python. Declared in deps.conf's [bash] section.
#
# Legacy .xls needs no special case — calamine parses BIFF directly, and it
# is the reason 2xlsx is rarely necessary. The usual motive for converting
# .xls to .xlsx first is that openpyxl and pandas cannot read .xls at all;
# that constraint simply isn't present here.
#
# Why not duckdb, which is the obvious alternative and measured *faster* here
# (0.32s vs 0.47s on 200k rows, at a fifth of the RSS — qsv materialises the
# sheet, duckdb streams it):
#
#   1. Its xlsx reader is zip-only. A legacy BIFF .xls fails outright with
#      "Failed to open zip for reading", and the spatial/st_read fallback
#      fails too — GDAL can't open it either. That's half the `xls*` this is
#      for, and no flag fixes it.
#   2. Its default typing renders an integer id column as 1.0, 2.0. Excel
#      stores every number as a double and duckdb faithfully believes it;
#      you need all_varchar=true to get the literal cell back.
#
# So duckdb needs a second engine bolted on for .xls and a flag to stop it
# corrupting ids. One tool that's correct by default beats two that aren't.
#
# If you ever want to *filter or join* during conversion rather than dump a
# sheet, that's duckdb's job and worth reaching for separately.
#
# 2parquet/2feather/2pickle were the obvious place to reach for it, and duckdb
# lost there too — for a third reason, not the two above. It cannot write Arrow
# IPC: v1.5.5 has no `arrow` COPY function, and the arrow extension is not
# published for linux_amd64 (the registry offers avro, azure, parquet,
# autocomplete, aws). It writes parquet perfectly, but a parquet-only engine
# still leaves feather and pickle needing python, and two engines for three
# formats is worse than one. Hence bash/tabular.py. Note this is not a reversal
# of the paragraph above: filtering and joining are still duckdb's job.
#
# csv→txt goes through `qsv fmt`, not `tr ',' '\t'`, because a blind
# translate corrupts any quoted field containing a comma. qsv re-quotes
# correctly: "alpha, inc" loses its quotes in tab output, 'quote"d' keeps them.
#
# Depends on: qsv  (2xlsx additionally: ssconvert, commented in deps.conf)
_sheet_convert() {
    local target="$1"; shift
    local cmd="2${target}" outdelim="" sheet="" force=0 f ext out rc=0
    local columnar="" outext="$target" script="" codec=""
    local files=() sheetarg=() uvargs=() codecarg=()

    case "$target" in
        csv)     outdelim=',' ;;
        txt)     outdelim='\t' ;;
        parquet) columnar=1 ;;
        feather) columnar=1 ;;
        # .pkl, not .pickle — the extension every pandas example uses.
        pickle)  columnar=1; outext=pkl ;;
    esac

    if [[ "$target" == "xlsx" ]]; then
        if ! command -v ssconvert &>/dev/null; then
            echo "$cmd: needs ssconvert — uncomment the gnumeric line in" >&2
            echo "      deps.conf [bash], then: make install bash" >&2
            echo "      (qsv reads .xls directly, so $cmd is only for" >&2
            echo "       producing a real workbook — 2csv/2txt don't need it)" >&2
            return 127
        fi
    elif [[ -n "$columnar" ]]; then
        if ! command -v uv &>/dev/null; then
            echo "$cmd: needs uv — see https://docs.astral.sh/uv/" >&2
            return 127
        fi
        script="$(_dotfiles_dir)/bash/tabular.py"
        if [[ ! -f "$script" ]]; then
            echo "$cmd: cannot find tabular.py (looked in $script)" >&2
            return 127
        fi
        # tabular.py declares only polars (215M cached), which covers parquet
        # and feather. pickle additionally needs pandas and pyarrow, taking the
        # environment to 476M — layered on here rather than in the script's
        # header so 2parquet and 2feather never pay for it.
        [[ "$target" == "pickle" ]] && uvargs=(--with pandas --with pyarrow)
    elif ! command -v qsv &>/dev/null; then
        echo "$cmd: qsv not installed — run: make install bash" >&2
        return 127
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -s|--sheet) sheet="$2"; shift 2 ;;
            -f|--force) force=1; shift ;;
            -c|--compression)
                if [[ -z "$columnar" ]]; then
                    echo "$cmd: -c only applies to 2parquet and 2feather" >&2; return 2
                fi
                codec="$2"; shift 2 ;;
            -h|--help)  echo "usage: $cmd [-s <sheet>] [-f] <file>..." >&2; return 0 ;;
            --)         shift; while [[ $# -gt 0 ]]; do files+=("$1"); shift; done ;;
            -*)         echo "$cmd: unknown flag '$1'" >&2; return 2 ;;
            *)          files+=("$1"); shift ;;
        esac
    done

    if [[ ${#files[@]} -eq 0 ]]; then
        echo "usage: $cmd [-s <sheet>] [-f] <file>..." >&2
        return 2
    fi

    # -s selects one sheet to flatten into one delimited file. Converting a
    # whole workbook to a workbook keeps every sheet, so the flag has nothing
    # to mean here — say so instead of ignoring it.
    if [[ "$target" == "xlsx" && -n "$sheet" ]]; then
        echo "$cmd: -s doesn't apply — a workbook keeps all its sheets" >&2
        return 2
    fi
    [[ -n "$sheet" ]] && sheetarg=(--sheet "$sheet")
    [[ -n "$codec" ]] && codecarg=("$codec")

    for f in "${files[@]}"; do
        if [[ ! -f "$f" ]]; then
            echo "$cmd: no such file: $f" >&2; rc=1; continue
        fi

        out="${f%.*}.${outext}"
        if [[ "$out" == "$f" ]]; then
            echo "$cmd: $f is already .${outext}" >&2; rc=1; continue
        fi
        if [[ -e "$out" && $force -eq 0 ]]; then
            echo "$cmd: $out exists (use -f to overwrite)" >&2; rc=1; continue
        fi

        # bash 3.2 has no ${var,,}, so lowercase the extension with tr.
        ext=$(printf '%s' "${f##*.}" | tr '[:upper:]' '[:lower:]')
        case "$ext" in
            xlsx|xlsm|xlsb|xls|ods|csv|tsv|tab|txt) ;;
            parquet|feather|arrow|ipc)
                # Columnar in, columnar out. Only the python engine reads
                # these, so they are not valid input for 2csv/2txt/2xlsx.
                if [[ -z "$columnar" ]]; then
                    echo "$cmd: don't know how to read '$f'" >&2; rc=1; continue
                fi
                ;;
            *) echo "$cmd: don't know how to read '$f'" >&2; rc=1; continue ;;
        esac

        if [[ "$target" == "xlsx" ]]; then
            ssconvert "$f" "$out" >/dev/null 2>&1 \
                || { echo "$cmd: ssconvert failed on $f" >&2; rc=1; continue; }
        elif [[ -n "$columnar" ]]; then
            # Excel never reaches tabular.py. qsv flattens it to a temp CSV
            # first, because calamine reads legacy BIFF .xls that nothing
            # else here will, and because Excel stores integers as doubles —
            # a naive reader turns an id column into 1.0, 2.0.
            case "$ext" in
                xlsx|xlsm|xlsb|xls|ods)
                    local tmp
                    if ! command -v qsv &>/dev/null; then
                        echo "$cmd: reading Excel needs qsv — run: make install bash" >&2
                        rc=1; continue
                    fi
                    tmp="$(mktemp -t 2col.XXXXXX)" || { rc=1; continue; }
                    mv "$tmp" "$tmp.csv"; tmp="$tmp.csv"
                    if ! qsv excel --quiet "${sheetarg[@]}" --output "$tmp" "$f"; then
                        rm -f "$tmp"; rc=1; continue
                    fi
                    uv run --quiet "${uvargs[@]}" "$script" "$tmp" "$out" "$target" "${codecarg[@]}" || rc=1
                    rm -f "$tmp"
                    [[ $rc -eq 0 ]] || continue
                    ;;
                *)
                    uv run --quiet "${uvargs[@]}" "$script" "$f" "$out" "$target" "${codecarg[@]}" \
                        || { rc=1; continue; }
                    ;;
            esac
        else
            case "$ext" in
                xlsx|xlsm|xlsb|xls|ods)
                    qsv excel --quiet "${sheetarg[@]}" --delimiter "$outdelim" \
                        --output "$out" "$f" || { rc=1; continue; }
                    ;;
                *)
                    qsv fmt --out-delimiter "$outdelim" --output "$out" "$f" \
                        || { rc=1; continue; }
                    ;;
            esac
        fi
        echo "$out"
    done
    return $rc
}

# Function names may begin with a digit in bash.
2csv()  { _sheet_convert csv  "$@"; }
2txt()  { _sheet_convert txt  "$@"; }
2xlsx() { _sheet_convert xlsx "$@"; }

# Columnar targets. These go through bash/tabular.py rather than qsv — see
# the comment block above _sheet_convert and `h 2parquet`.
2parquet() { _sheet_convert parquet "$@"; }
2feather() { _sheet_convert feather "$@"; }
2pickle()  { _sheet_convert pickle  "$@"; }

# Where this repo lives, resolved from the symlink bashrc was sourced through.
# Plain `readlink`, not `readlink -f`: macOS is CI-tested only and BSD readlink
# has no -f, so -f is tried first and the portable spelling is the fallback.
_dotfiles_dir() {
    local link
    link="$(readlink -f ~/.bashrc 2>/dev/null || readlink ~/.bashrc)"
    (cd "$(dirname "$link")/.." && pwd)
}

# edit/reload dotfiles (symlinked by install.sh)
edit-dotfiles() {
    local dotdir
    dotdir="$(cd "$(dirname "$(readlink -f ~/.bashrc 2>/dev/null || readlink ~/.bashrc)")" && pwd)"
    "$EDITOR" "$dotdir"
}

reload() {
    # shellcheck source=/dev/null  # runtime path, not resolvable at lint time
    source ~/.bashrc
    echo "Reloaded ~/.bashrc"
}

