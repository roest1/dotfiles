#!/usr/bin/env bash
# ~/.bash_git
#
# Git CLI commands
# Source this from .bashrc:
#   source ~/.bash_git

# ─── Git aliases ──────────────────────────────────────────────────────────────
# Muscle-memory shortcuts. `gs` instead of `git status`, etc.
alias gs='git status'
alias gc='git commit -m'
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gco='git checkout'
alias gcob='git checkout -b'
gb() {
  git for-each-ref --format='%(refname:short) %(ahead-behind:HEAD) %(HEAD)' refs/heads |
  awk 'BEGIN{w=6}
    { n[NR]=$1; a[NR]=$2; b[NR]=$3; h[NR]=($4=="*"); if (length($1)>w) w=length($1) }
    END {
      printf "\033[1m  %-*s %10s %10s\033[0m\n", w, "BRANCH", "BEHIND", "AHEAD"
      for (i=1;i<=NR;i++)
        printf "%s\033[%sm%-*s\033[0m \033[31m%10s\033[0m \033[32m%10s\033[0m\n",
               (h[i] ? "* " : "  "), (h[i] ? "32" : "0"), w, n[i], b[i], a[i]
    }'
}
alias gbd='git branch -d'

# gprune: fetch + prune remotes + delete local branches whose remote is gone
gprune() {
  echo "⏳ Fetching and pruning remote tracking refs..."
  git fetch --prune

  local gone_branches
  gone_branches=$(git for-each-ref --format '%(refname:short) %(upstream:track)' refs/heads \
    | awk '$2 == "[gone]" { print $1 }')

  if [[ -z "$gone_branches" ]]; then
    echo "✅ No stale branches to clean up"
    return
  fi

  echo ""
  echo "Branches with deleted remotes:"
  echo "$gone_branches" | sed 's/^/  /'
  echo ""
  read -rp "Delete these local branches? (y/N): " confirm
  if [[ "$confirm" =~ ^[yY]$ ]]; then
    echo "$gone_branches" | while IFS= read -r branch; do
      git branch -D "$branch" && echo "  🗑  Deleted: $branch"
    done
    echo "✅ Done"
  fi
}
