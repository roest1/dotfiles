#!/usr/bin/env bash
# ~/.bash_github_tui
#
# Interactive GitHub TUI — fzf-powered screens
# Source this from .bashrc:
#   source ~/.bash_github_tui
#
# Commands:
#   github        All of GitHub for the current repo, in one TUI
#
# The non-interactive gh command (gha) and the shared helpers (__gh_check,
# __gh_repo, __gh_default_branch, _open_url) live in bash_github, which is
# sourced first. Everything here may use them. This file is the only one of
# the three that may invoke fzf, and CI enforces that — it is what keeps this
# layer replaceable as a unit.
#
# HOW IT IS BUILT
#
# Every screen is one fzf window: a list on the left, a live preview on the
# right, and single-key actions on the list. Screens open instantly because
# nothing is fetched before fzf starts — the list arrives through a
# `start:reload` binding and the preview renders per item, cached. Nothing
# stops to say "press r to refresh"; the preview *is* the view.
#
# fzf's preview, reload and execute commands run in a child shell that has
# none of these functions. Rather than materialise every renderer as a
# separate script, github writes ONE worker script per session — every
# `_gh*` function in this file, dumped with `declare -f`, plus a dispatcher —
# and every fzf command is `bash $W <verb> args…`. So a preview is an
# ordinary bash function in this file, shellchecked and sourced like the
# rest, and the only rule is that a function running over there may call
# other functions from this file, the fzf wrappers and time helpers named in
# _gh_worker_write, and nothing else from the parent shell.
#
# Screens open other screens the same way: `enter` is an execute() that runs
# `bash $W screen-steps …`, a nested fzf. The parent fzf stays alive under
# it with its cursor, filter and scroll, so esc is genuinely back. Nothing
# loops to a menu; there is no menu to loop back to.
#
# Live data: each screen runs fzf with --listen, which hands its child
# commands an FZF_PORT. A preview that renders something still in progress
# schedules one `refresh-preview` POST a few seconds out, so a running
# workflow updates under the cursor without a keypress; the hub's prefetch
# does the same as each pane's data lands. This is why the floor is fzf 0.65
# (2025) rather than whatever the distro ships — see _gh_fzf_ok.
#
# Navigation — nvim friendly, and the same everywhere:
#   Lists:  type to filter   enter select   esc back   ctrl-r refresh
#           ctrl-o open in browser   ctrl-/ help   (other keys in the footer)
#   Menus:  ↑↓ / jk   enter select   -/q back   ? help
#   Preview scroll: shift-↑↓ · alt-j/k · mouse wheel
#
# Dependencies: gh, fzf ≥ 0.65, jq, curl (live refresh only — degrades to
# manual ctrl-r without it)

# ─── Chrome ───────────────────────────────────────────────────────
#
# One palette, one fzf style, applied to every screen — the same eight
# colours the prompt uses (bash_theme), so the TUI reads as part of the
# shell rather than a visitor in it. `_gh_palette` is a function rather
# than top-level assignments because the worker script needs the same
# values and gets them the same way everything else does: `declare -f`.

_gh_palette() {
  _C0=$'\033[0m'            _CB=$'\033[1m'
  _C_RED=$'\033[38;5;203m'  _C_GRN=$'\033[38;5;150m'
  _C_YEL=$'\033[38;5;214m'  _C_ORG=$'\033[38;5;215m'
  _C_PUR=$'\033[38;5;141m'  _C_TAN=$'\033[38;5;180m'
  _C_BLU=$'\033[38;5;110m'  _C_WHT=$'\033[38;5;255m'
  _C_GRY=$'\033[38;5;245m'  _C_DIM=$'\033[38;5;240m'
}

# The fzf floor. Everything below assumes --listen (0.36), the `focus` and
# `start` events (0.36), `execute` returning to the list (0.38), border and
# preview labels (0.35), transform-* actions (0.45), --style (0.60) and
# --footer (0.65). Ubuntu's apt carries 0.29 (22.04) and 0.44 (24.04), so
# deps.conf installs fzf through mise first — the same reasoning as nvim —
# and this check says what to do on a machine that hasn't re-run install.
_gh_fzf_ok() {
  local have maj min rest
  have=$(fzf --version 2>/dev/null | awk '{ print $1 }')
  [[ -z "$have" ]] && return 1
  # Major/minor arithmetic rather than sort -V: bash/deps.sh enforces the
  # same floor at install time with the same test, so the two can't disagree.
  maj="${have%%.*}"; rest="${have#*.}"; min="${rest%%.*}"
  maj="${maj//[!0-9]/}"; min="${min//[!0-9]/}"
  if [[ -n "$maj" ]] && (( maj > 0 || ${min:-0} >= 65 )); then return 0; fi
  echo "❌ github needs fzf ≥ 0.65 (have $have) — run: make install bash" >&2
  echo "   (or: mise use -g fzf@latest)" >&2
  return 1
}

# Common flags for a LIST screen. Menus keep going through __fzf_menu
# (bash_productivity), which owns the -/q/? contract; they get the same
# chrome by having _GH_STYLE appended after the title.
_gh_style() {
  _GH_STYLE=(
    --height=100% --layout=reverse --ansi --style=full:rounded
    --info=inline-right --no-separator
    --pointer='▶' --marker='✓' --scrollbar='▐' --ellipsis='…'
    --highlight-line
    --color='border:240,label:215:bold,list-border:240,input-border:240,header-border:240,footer-border:240,preview-border:240'
    --color='preview-label:215:bold,list-label:250,header:250,footer:245,prompt:141,pointer:215,marker:150'
    --color='hl:215,hl+:215:bold,fg+:255,bg+:236,info:141,spinner:150,gutter:-1,query:255,disabled:245'
  )
  _GH_PREVIEW=(--preview-window='right,58%,wrap,<60(down,60%,wrap)')
}

# fzf for a list screen. Wraps the shared style, the listen socket, the
# preview scroll keys and the universal bindings; each screen adds its own
# --preview, --bind and --footer on top.
#
#   _gh_fzf <help-name> [fzf args...]
#
# Output is whatever fzf prints (with --expect, the key then the line).
_gh_fzf() {
  local help="$1"; shift
  local -a binds=(
    --bind='alt-k:preview-up,alt-j:preview-down,alt-u:preview-half-page-up,alt-d:preview-half-page-down'
    --bind='alt-p:toggle-preview'
    --bind="ctrl-/:execute(less -R -- '$_GH_D/help/$help')"
  )
  fzf "${_GH_STYLE[@]}" "${_GH_PREVIEW[@]}" --listen "${binds[@]}" "$@"
}

# A menu with the same chrome. Same contract as __fzf_menu, full screen.
_gh_menu() {
  local title="$1"; shift
  __fzf_menu "$title" "${_GH_STYLE[@]}" --no-info --no-input "$@"
}

# yes/no as a menu, so a confirmation looks like every other screen instead
# of a bare read prompt under it. Returns 0 on yes.
_gh_confirm() {
  local q="$1" yes="${2:-Yes}" no="${3:-No}" pick
  pick=$(printf '%s\n' "$no" "$yes" \
    | _gh_menu "$q" --border-label=" ⚠  confirm " --height=100%)
  [[ "$pick" == "$yes" ]]
}

# A one-line text input inside the fzf chrome. Prints what was typed;
# empty on esc. Given no items, fzf is a prompt with --print-query.
_gh_input() {
  local prompt="$1" initial="${2:-}" out
  out=$(printf '' | fzf "${_GH_STYLE[@]}" --print-query --prompt="$prompt " \
          --query="$initial" --header="enter accept   esc cancel" \
          --border-label=" ✏  input " --no-info 2>/dev/null | head -1)
  printf '%s' "$out"
}

# Pause on a message. Only used after a terminal-writing action that has no
# screen of its own to return to (a merge, a create); the screens themselves
# never ask you to press a key.
_gh_pause() {
  local _k
  echo ""
  read -rsn1 -p "  any key to continue " _k; echo ""
}

# Announce the session to wezterm, which paints the tab's status glyph from
# the pane's USER VARS — the same channel wezterm.lua already reads Claude
# Code's state on. OSC 1337 SetUserVar, base64 value, written straight to the
# tty: no `wezterm cli` (broken on this machine — WEZTERM_UNIX_SOCKET points
# at a gui-sock that does not exist) and no file I/O per repaint.
#
# /dev/tty rather than stdout, because github's own stdout is redirected to
# /dev/null and every screen runs inside fzf's alternate screen.
#
# Silent everywhere else: an unrecognised OSC is discarded by every terminal
# that isn't wezterm, so there is nothing to guard on beyond having a tty.
#
# The off value is "0", not "". wezterm documents SetUserVar as name plus a
# base64 payload and documents no way to UNSET one, so clearing by sending an
# empty payload is betting on how its parser treats a zero-length decode — and
# losing that bet leaves the pane wearing the mark until the shell dies. A var
# that is present and reads "0" needs no such bet; the handler tests for "1".
# The var is `gh_tui`, not `github`, and that is deliberate now that the command
# is called `github`. This is a WIRE NAME: bash writes it in the WSL guest and
# wezterm/shared.lua reads it on the Windows host, out of a SEPARATE clone. So
# renaming it is a two-clone flag day -- the tab mark disappears until `make
# windows` has pulled the host side -- bought for no user-visible gain, since
# nobody types this. Same reasoning that keeps this file called
# bash_github_tui: names that are read by something other than a person change
# only when there is a reason beyond tidiness.
_gh_tab_var() {
  [[ -w /dev/tty ]] || return 0
  command -v base64 >/dev/null 2>&1 || return 0
  printf '\033]1337;SetUserVar=gh_tui=%s\007' \
    "$(printf %s "$1" | base64 | tr -d '\n')" >/dev/tty 2>/dev/null || true
}

# ─── Worker ───────────────────────────────────────────────────────
#
# Everything from here to `_gh_worker_write` runs INSIDE fzf's child
# processes — previews, reloads, execute bindings — via `bash $W verb…`,
# where $W is the script _gh_worker_write materialises per session. That
# script starts with three baked-in facts, and the functions read them as
# globals:
#
#   $D       the session dir (lists, ticks, port files, in-progress bodies)
#   $R       owner/repo
#   $CACHE   persistent, per-repo: rendered bodies of COMPLETED runs and the
#            logs of completed jobs — both immutable, so a second visit to a
#            run is instant even in a new shell. Pruned by age at startup.
#
# A `_ghw_` function may call other `_ghw_` functions, _gh_palette, _open_url,
# and the time helpers from bash_theme. Nothing else exists over there.

_ghw_main() {
  local verb="${1:-}"; shift || true
  case "$verb" in
    list-runs)     _ghw_list_runs "$@" ;;
    runs-label)    _ghw_runs_label ;;
    runs-toggle)   _ghw_runs_toggle ;;
    pv-run)        _ghw_pv_run "$@" ;;
    list-steps)    _ghw_list_steps "$@" ;;
    pv-job)        _ghw_pv_job "$@" ;;
    pv-step)       _ghw_pv_step "$@" ;;
    log-job)       _ghw_log_job "$@" ;;
    log-step)      _ghw_log_step "$@" ;;
    log-run)       _ghw_log_run "$@" ;;
    rerun)         _ghw_rerun "$@" ;;
    cancel)        _ghw_cancel "$@" ;;
    open)          _open_url "$1" ;;
    list-prs)      _ghw_list_prs "$@" ;;
    prs-label)     _ghw_prs_label ;;
    prs-next)      _ghw_prs_next ;;
    pv-pr)         _ghw_pv_pr "$@" ;;
    list-branches) _ghw_list_branches "$@" ;;
    pv-branch)     _ghw_pv_branch "$@" ;;
    list-secrets)  _ghw_list_secrets "$@" ;;
    pv-secret)     _ghw_pv_secret "$@" ;;
    list-envs)     _ghw_list_envs "$@" ;;
    pv-env)        _ghw_pv_env "$@" ;;
    hub-prefetch)  _ghw_hub_prefetch "$@" ;;
    hub-refresh)   _ghw_hub_refresh ;;
    pv-hub)        _ghw_pv_hub "$@" ;;
    screen)        _ghw_screen "$@" ;;
    screen-actions)     _gh_screen_actions ;;
    screen-actions-for) _gh_screen_actions_for "$@" ;;
    screen-steps)       _gh_screen_steps "$@" ;;
    screen-prs)         _gh_screen_prs ;;
    screen-branches)    _gh_screen_branches ;;
    screen-secrets)     _gh_screen_secrets ;;
    screen-envs)        _gh_screen_envs ;;
    open-run)      _ghw_open_run "$@" ;;
    open-branch)   _ghw_open_branch "$@" ;;
    open-settings) _ghw_open_settings "$@" ;;
    pr-checkout)   _ghw_pr_checkout "$@" ;;
    pr-create)     _ghw_pr_create ;;
    pr-menu)       _ghw_pr_menu "$@" ;;
    branch-checkout) _ghw_branch_checkout "$@" ;;
    branch-delete) _ghw_branch_delete "$@" ;;
    branch-menu)   _ghw_branch_menu "$@" ;;
    rulesets)      _ghw_rulesets ;;
    secret-set)    _ghw_secret_set "$@" ;;
    secret-delete) _ghw_secret_delete "$@" ;;
    env-create)    _ghw_env_create ;;
    env-delete)    _ghw_env_delete "$@" ;;
    env-menu)      _ghw_env_menu "$@" ;;
    *) echo "github worker: unknown verb '$verb'" >&2; return 1 ;;
  esac
}

# POST an action string to the fzf instance that spawned us. --listen puts
# the port in FZF_PORT for every child command; a caller that already
# knows a port (the hub prefetch, which outlives any one preview) passes
# it. Without curl this is a no-op and the screens still work — you just
# press ctrl-r yourself.
_ghw_notify() {
  local port="${2:-${FZF_PORT:-}}"
  [[ -z "$port" ]] && return 0
  command -v curl &>/dev/null || return 0
  curl -s -m 2 -X POST "localhost:$port" -d "$1" >/dev/null 2>&1
}

# Schedule ONE deferred POST per fzf instance. A preview that shows a run
# still in progress calls this; when the timer fires the preview re-renders,
# sees it is still running, and schedules the next one — a live view that
# stops by itself the moment the run completes. The lock file holds the
# expiry, so ten previews of ten running jobs share one timer rather than
# stacking ten.
_ghw_tick() {
  local secs="$1" action="$2" now
  [[ -z "${FZF_PORT:-}" || -n "${GHW_PREFETCH:-}" ]] && return 0
  now=$(date +%s)
  local lock="$D/tick.$FZF_PORT"
  if [[ -s "$lock" ]] && (( $(<"$lock") > now )); then return 0; fi
  echo $(( now + secs + 2 )) > "$lock"
  ( sleep "$secs"; rm -f "$lock"; _ghw_notify "$action" "$FZF_PORT" ) >/dev/null 2>&1 </dev/null &
}

# jq helpers shared by every renderer. A string, spliced in front of each
# program, so the glyph for "cancelled" is decided in exactly one place.
_ghw_jq_defs() {
  cat <<'JQ'
def glyph:
  if .status == "completed" then
    ( .conclusion as $c
    | if   $c == "success"          then "✅"
      elif $c == "failure"          then "❌"
      elif $c == "cancelled"        then "🚫"
      elif $c == "skipped"          then "⏭ "
      elif $c == "timed_out"        then "⏰"
      elif $c == "action_required"  then "⚠️ "
      elif $c == "startup_failure"  then "💥"
      elif $c == "neutral" or $c == "stale" then "⚪"
      else "❓" end )
  elif .status == "in_progress" then "⏳"
  elif .status == "queued" or .status == "waiting" or .status == "pending" or .status == "requested" then "🕒"
  else "⏳" end;
def when: if .status == "completed" then (.conclusion // "?") else (.status | gsub("_"; " ")) end;
def age: if . < 60 then "now" elif . < 3600 then "\(./60|floor)m" elif . < 86400 then "\(./3600|floor)h"
         elif . < 604800 then "\(./86400|floor)d" else "\(./604800|floor)w" end;
def dur: if . == null then "" elif . >= 3600 then "\(./3600|floor)h\((. % 3600)/60|floor)m"
         elif . >= 60 then "\(./60|floor)m\(. % 60)s" else "\(.)s" end;
def secs: if . == null or . == "" then null else (sub("\\.[0-9]+"; "") | fromdateiso8601) end;
def lpad(n): tostring | (n - length) as $p | if $p > 0 then (" " * $p) + . else . end;
def rpad(n): tostring | (n - length) as $p | if $p > 0 then . + (" " * $p) else . end;
def trunc(n): if length > n then .[:n-1] + "…" else . end;
def dots(n): (n - length) as $p | if $p > 1 then . + " " + ("·" * ($p - 1)) else . + " " end;
def event: if . == "pull_request" then "pr" elif . == "workflow_dispatch" then "manual"
           elif . == "schedule" then "cron" elif . == "pull_request_target" then "pr-tgt"
           elif . == "dynamic" then "dyn" else . end;
JQ
}

# mtime, GNU or BSD stat.
_ghw_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
}

# ─── Actions: the run list ─────────────────────────────────────────

# One line per run, newest first. The visible column is field 1; the rest
# are tab-separated facts the preview and the key bindings read back, so
# nothing is fetched twice for something the list already knew.
#
#   fresh   bypass the 15s list cache (ctrl-r)
#
# The branch scope (this branch / all) is a file, flipped by _ghw_runs_toggle
# — which ctrl-b runs as a transform-list-label, i.e. synchronously, BEFORE
# the reload that reads it. Doing the flip inside the reload raced the label.
_ghw_list_runs() {
  local mode="" arg
  [[ -f "$D/runs.branch" ]] && mode=branch
  for arg in "$@"; do
    [[ "$arg" == fresh ]] && rm -f "$D"/runs.*.json
  done

  local q="per_page=40" br sha
  br=$(git symbolic-ref --short HEAD 2>/dev/null)
  sha=$(git rev-parse HEAD 2>/dev/null)
  if [[ -n "$mode" && -n "$br" ]]; then
    q+="&branch=$(printf '%s' "$br" | jq -sRr @uri)"
  fi
  # A commit filter (the PR screen's "checks" jump) is a file, like the branch
  # mode, so reload bindings need no arguments they'd have to be told about.
  [[ -s "$D/runs.sha" ]] && q+="&head_sha=$(<"$D/runs.sha")"

  local json="$D/runs.$mode.json"
  if [[ ! -s "$json" ]] || (( $(date +%s) - $(_ghw_mtime "$json") > 15 )); then
    gh api "repos/$R/actions/runs?$q" > "$json.tmp" 2>/dev/null && mv "$json.tmp" "$json"
  fi
  [[ -s "$json" ]] || { printf '%s❌ could not list workflow runs for %s%s\n' "$_C_RED" "$R" "$_C0"; return; }

  jq -r --arg sha "$sha" --argjson now "$(date +%s)" \
     --arg C0 "$_C0" --arg CB "$_CB" --arg ORG "$_C_ORG" --arg DIM "$_C_DIM" \
     --arg GRY "$_C_GRY" --arg PUR "$_C_PUR" --arg YEL "$_C_YEL" \
     "$(_ghw_jq_defs)"'
    (.workflow_runs // []) as $r
    | if ($r | length) == 0 then ([$DIM + "  no workflow runs here yet" + $C0, "none"] | @tsv) else
    ($r | map(.name) | unique | length > 1) as $multi
    | ([$r[].head_branch | length] | max // 4 | if . > 18 then 18 else . end) as $bw
    | $r[]
    | (if .status == "completed" then ((.updated_at|secs) - (.run_started_at|secs))
       else ($now - (.run_started_at|secs)) end) as $d
    | [ ( glyph + " "
          + (if .head_sha == $sha then $ORG + "●" + $C0 else " " end)
          + $DIM + (($now - (.created_at|secs)) | age | lpad(3)) + " "
          + ($d | dur | lpad(6)) + $C0 + "  "
          + $GRY + (.event | event | trunc(6) | rpad(6)) + $C0 + " "
          + $ORG + (.head_branch | trunc($bw) | rpad($bw)) + $C0 + "  "
          + (if $multi then $PUR + .name + $C0 + " · " else "" end)
          + (.display_title | gsub("[\t\n]"; " ")) ),
        .id, .status, (.conclusion // ""), .html_url, .name, .head_branch, .event,
        (.display_title | gsub("[\t\n]"; " ")), .created_at, (.run_started_at // .created_at),
        .updated_at, .run_number, .run_attempt, .head_sha, (.actor.login // "")
      ] | @tsv end' "$json"

  # Warm the previews of the first few runs so the first hovers are instant.
  # Detached, quiet, and told not to schedule refresh ticks of its own.
  (
    export GHW_PREFETCH=1; unset FZF_PORT
    jq -r '.workflow_runs[:6][] | "\(.id) \(.run_attempt)"' "$json" 2>/dev/null | while read -r id att; do
      _ghw_run_body "$id" "" "$att" >/dev/null 2>&1 &
    done
    wait
  ) >/dev/null 2>&1 </dev/null &
}

_ghw_runs_toggle() {
  if [[ -f "$D/runs.branch" ]]; then rm -f "$D/runs.branch"; else : > "$D/runs.branch"; fi
  _ghw_runs_label
}

_ghw_runs_label() {
  local br
  if [[ -s "$D/runs.sha" ]]; then
    printf ' commit %s ' "$(cut -c1-7 < "$D/runs.sha")"
  elif [[ -f "$D/runs.branch" ]]; then
    br=$(git symbolic-ref --short HEAD 2>/dev/null)
    printf ' ⎇ %s ' "${br:-HEAD}"
  else
    printf ' all branches '
  fi
}

# ─── Actions: one run, rendered ────────────────────────────────────

# Preview for a run. The lines that never change — workflow, title, branch,
# who and why — come straight from the list fields and print at once; the
# body (status, jobs, steps, failed-step logs) is fetched, rendered and
# cached by _ghw_run_body.
_ghw_pv_run() {
  [[ "$1" == none || -z "$1" ]] && { printf '%sNothing has run here yet.%s\n' "$_C_DIM" "$_C0"; return; }
  local id="$1" wf="$5" br="$6" ev="$7" title="$8" created="$9" num="${12}" att="${13}" actor="${15}"
  printf '%s%s%s %s#%s%s' "$_CB$_C_PUR" "$wf" "$_C0" "$_C_DIM" "$num" "$_C0"
  (( att > 1 )) 2>/dev/null && printf ' %s(attempt %s)%s' "$_C_DIM" "$att" "$_C0"
  printf '  %s%s%s\n' "$_C_ORG" "$br" "$_C0"
  printf '%s%s%s\n' "$_CB" "$title" "$_C0"
  printf '%s%s · %s · %s ago%s\n' "$_C_GRY" "$(printf '%s' "$ev" | tr '_' ' ')" \
    "${actor:-?}" "$(__relative_time "$created")" "$_C0"
  _ghw_rule
  _ghw_run_body "$id" "$2" "$att"
}

_ghw_rule() {
  printf '%s────────────────────────────────────────────────────────%s\n' "$_C_DIM" "$_C0"
}

# The cached, width-independent body of a run. Two calls, in parallel: the
# run (its status is authoritative — the list line may be 15s stale) and its
# jobs. One jq pass lays out jobs and steps; failed steps come out as marker
# lines that the loop below swaps for the tail of that step's log.
_ghw_run_body() {
  local id="$1" seen="${2:-}" att="${3:-0}"
  local final="$CACHE/run-$id-a$att.body" live="$D/run-$id.body"
  if [[ -s "$final" ]]; then cat "$final"; return; fi
  if [[ -s "$live" ]] && (( $(date +%s) - $(_ghw_mtime "$live") < 4 )); then
    cat "$live"
    _ghw_tick 5 'refresh-preview'
    return
  fi

  local t="$D/run-$id"
  # Someone (the prefetch, a previous hover) may be rendering this already.
  if ! mkdir "$t.lock" 2>/dev/null; then
    for _ in $(seq 1 25); do
      sleep 0.2
      [[ -s "$final" ]] && { cat "$final"; return; }
      [[ -s "$live" ]] && { cat "$live"; _ghw_tick 5 'refresh-preview'; return; }
    done
    rmdir "$t.lock" 2>/dev/null   # stale — the other side died
    mkdir "$t.lock" 2>/dev/null || return
  fi

  gh api "repos/$R/actions/runs/$id" > "$t.run" 2>/dev/null &
  gh api "repos/$R/actions/runs/$id/jobs?per_page=100" > "$t.jobs" 2>/dev/null &
  wait
  if [[ ! -s "$t.run" || ! -s "$t.jobs" ]]; then
    rmdir "$t.lock" 2>/dev/null
    printf '%s❌ could not fetch run %s%s\n' "$_C_RED" "$id" "$_C0"
    return
  fi

  local status
  status=$(jq -r '.status' "$t.run")

  # Failed jobs' logs, fetched together before the render loop needs them.
  # Only completed jobs have logs at all — GitHub serves nothing for a job
  # still running — so the loop's "log not available yet" is honest.
  local jid
  for jid in $(jq -r '.jobs[] | select(.status == "completed" and .conclusion == "failure") | .id' "$t.jobs"); do
    _ghw_job_log "$jid" >/dev/null 2>&1 &
  done
  wait

  {
    jq -r --slurpfile run "$t.run" --argjson now "$(date +%s)" \
       --arg C0 "$_C0" --arg CB "$_CB" --arg RED "$_C_RED" --arg GRN "$_C_GRN" \
       --arg YEL "$_C_YEL" --arg DIM "$_C_DIM" --arg GRY "$_C_GRY" --arg ORG "$_C_ORG" \
       "$(_ghw_jq_defs)"'
      $run[0] as $r
      | ($r | if .status == "completed" then ((.updated_at|secs) - (.run_started_at|secs))
              else ($now - ((.run_started_at // .created_at)|secs)) end) as $rd
      # ── status line ──
      | ( ($r | glyph) + " " + $CB
          + (if $r.status == "completed" then
               (if $r.conclusion == "success" then $GRN elif $r.conclusion == "failure" then $RED else $YEL end)
               + ($r | when)
             else $YEL + ($r | when) end)
          + $C0 + $DIM + " · " + ($rd | dur)
          + (if $r.status != "completed" then " so far" else "" end)
          + " · started " + (($r.run_started_at // $r.created_at) | .[11:16]) + " UTC" + $C0 )
      , ""
      # ── jobs ──
      , ( .jobs[]
          | (if .status == "completed" then ((.completed_at|secs) - (.started_at|secs))
             elif .started_at != null then ($now - (.started_at|secs)) else null end) as $jd
          | (.status == "completed" and .conclusion == "failure") as $failed
          | (.status != "completed") as $running
          | ( glyph + " "
              + (if $failed then $CB + $RED elif $running then $YEL else "" end)
              + (.name | trunc(46) | dots(48)) + $C0 + " "
              + $DIM + ($jd | dur | lpad(6)) + (if $running and $jd != null then " ⋯" else "" end) + $C0 )
          , ( if ($failed or $running) then
                ( .id as $jid
                | .steps[]
                | (if .status == "completed" then ((.completed_at|secs) - (.started_at|secs))
                   elif .started_at != null then ($now - (.started_at|secs)) else null end) as $sd
                | (.status == "in_progress") as $now_running
                | ( "   " + (if $now_running then $YEL + "▶ " elif .status != "completed" then $DIM + "○ " else glyph + " " end)
                    + (if .conclusion == "failure" then $RED elif $now_running then $YEL elif .status != "completed" then $DIM else "" end)
                    + (.name | trunc(43) | dots(45)) + $C0
                    + " " + $DIM + ($sd | dur | lpad(6)) + $C0 )
                , ( if .conclusion == "failure" and .started_at != null then
                      "\u0001LOG\t\($jid)\t\(.number)\t\(.started_at)\t\(.completed_at // "")\t\(.name)"
                    else empty end )
                )
              else empty end )
        )
      , ""
      # ── summary ──
      , ( ([.jobs[] | select(.conclusion == "success")] | length) as $ok
        | ([.jobs[] | select(.conclusion == "failure")] | length) as $bad
        | ([.jobs[] | select(.status != "completed")] | length) as $run
        | ([.jobs[] | select(.conclusion == "skipped")] | length) as $skip
        | ([.jobs[] | select(.conclusion == "cancelled")] | length) as $canc
        | ( (if $ok > 0 then "✅ \($ok) passed   " else "" end)
          + (if $bad > 0 then "❌ \($bad) failed   " else "" end)
          + (if $run > 0 then "⏳ \($run) running   " else "" end)
          + (if $canc > 0 then "🚫 \($canc) cancelled   " else "" end)
          + (if $skip > 0 then "⏭  \($skip) skipped   " else "" end)
          + (if (.jobs | length) == 0 then $DIM + "no jobs yet — waiting for a runner" + $C0 else "" end) )
        | rtrimstr("   ") )
    ' "$t.jobs" | while IFS= read -r line; do
      if [[ "$line" == $'\001LOG\t'* ]]; then
        local jid num start end sname
        IFS=$'\t' read -r _ jid num start end sname <<< "$line"
        _ghw_step_tail "$jid" "$start" "$end" "$sname" 18
      else
        printf '%s\n' "$line"
      fi
    done
  } > "$t.render"

  if [[ "$status" == "completed" ]]; then
    mv "$t.render" "$final"; rm -f "$live" "$t.run"
    mv "$t.jobs" "$CACHE/run-$id-a$att.jobs"
    cat "$final"
    # If the list line still says ⏳ — it saw this run mid-flight — refresh
    # it. Only then: a reload moves the cursor, so it has to earn its keep.
    if [[ -n "$seen" && "$seen" != completed && -z "${GHW_PREFETCH:-}" ]]; then
      _ghw_notify 'reload(bash '"$D/w"' list-runs fresh)'
    fi
  else
    mv "$t.render" "$live"
    cat "$live"
    _ghw_tick 5 'refresh-preview'
  fi
  rmdir "$t.lock" 2>/dev/null
}

# ─── Actions: logs ─────────────────────────────────────────────────

# The log of one job, from the per-job endpoint: ~15KB and half a second,
# where the whole run's log is megabytes and several. Immutable once the job
# has completed, so it lives in the persistent cache. Prints the path.
_ghw_job_log() {
  local jid="$1" f
  f="$CACHE/job-$jid.log"
  if [[ ! -s "$f" ]]; then
    # Unique temp: two previews can want the same log at the same moment.
    gh api --allow-escape-sequences "repos/$R/actions/jobs/$jid/logs" > "$f.$$" 2>/dev/null \
      && [[ -s "$f.$$" ]] && mv "$f.$$" "$f"
    rm -f "$f.$$"
  fi
  [[ -s "$f" ]] && printf '%s\n' "$f"
}

# The lines of a job log that belong to one step. GitHub no longer serves
# per-step logs (the run zip is one file per job now, which is why
# `gh run view --log` says UNKNOWN STEP), so this is reconstructed:
#
#   1. the coarse window: lines whose timestamp falls in [started, completed]
#      — second precision, so a sub-second step shares its second with its
#      neighbours and the window can hold three steps' worth;
#   2. inside it, the anchor: the step's own `##[group]Run …` line, preferring
#      one whose text is the step's name (true for unnamed and `uses:` steps);
#   3. the cut: the last `##[error]` before the next step's marker — a failed
#      step always ends on one — else that next marker, else the window end.
#
# Steps that never open a Run group (Set up job, Post …, Stop containers)
# get the whole window, which is the honest answer for them.
_ghw_step_slice() {
  local f="$1" start="${2:0:19}" end="${3:0:19}" name="${4:-}"
  awk -v s="$start" -v e="$end" -v name="$name" '
    { sub(/^\357\273\277/, ""); ts = substr($0, 1, 19) }
    ts < s { next }
    e != "" && ts > e { exit }
    { win[++n] = $0 }
    END {
      if (n == 0) exit
      a = 0
      for (i = 1; i <= n; i++) {
        if (win[i] ~ /Z ##\[group\]Run /) {
          if (a == 0) a = i
          t = win[i]; sub(/^[^ ]+ ##\[group\]/, "", t)
          if (t == name) { a = i; break }
        }
      }
      if (a == 0) a = 1
      z = n
      for (i = a + 1; i <= n; i++)
        if (win[i] ~ /Z (##\[group\]Run |Post job cleanup\.|Cleaning up orphan processes|Stop and remove container)/) { z = i - 1; break }
      last = 0
      for (i = a; i <= z; i++) if (win[i] ~ /Z ##\[error\]/) last = i
      if (last > 0) z = last
      for (i = a; i <= z; i++) print win[i]
    }
  ' "$f"
}

# GitHub's log markup → colour. Timestamps and CRs go; ##[group] becomes a
# ▸ heading, ##[error] a red ✖, ##[endgroup] disappears. Anything the tool
# itself coloured passes through — fzf's preview renders ANSI.
_ghw_fmt_log() {
  awk -v red="$_C_RED" -v yel="$_C_YEL" -v blu="$_C_BLU" -v dim="$_C_DIM" -v off="$_C0" -v b="$_CB" '
    { sub(/^\357\273\277/, ""); sub(/\r$/, ""); sub(/^[0-9-]+T[0-9:.]+Z ?/, "") }
    /^##\[endgroup\]/ { next }
    /^##\[error\]/    { sub(/^##\[error\]/, "");   print b red "✖ " $0 off; next }
    /^##\[warning\]/  { sub(/^##\[warning\]/, ""); print yel "⚠ " $0 off; next }
    /^##\[group\]/    { sub(/^##\[group\]/, "");   print blu "▸ " $0 off; next }
    /^##\[(notice|debug|command|section)\]/ { sub(/^##\[[a-z]+\]/, ""); print dim $0 off; next }
    { print }
  '
}

# The last N lines of a failed step, indented under its line in the run body.
_ghw_step_tail() {
  local jid="$1" start="$2" end="$3" name="$4" n="${5:-18}" f total slice
  f=$(_ghw_job_log "$jid") || {
    printf '     %s┃ log not available yet%s\n' "$_C_DIM" "$_C0"; return; }
  slice=$(_ghw_step_slice "$f" "$start" "$end" "$name")
  if [[ -z "$slice" ]]; then
    printf '     %s┃ (no output captured for this step)%s\n' "$_C_DIM" "$_C0"; return
  fi
  total=$(printf '%s\n' "$slice" | wc -l | tr -d ' ')
  if (( total > n )); then
    printf '     %s┃ ▴ %s earlier lines — enter to browse%s\n' "$_C_DIM" $(( total - n )) "$_C0"
  fi
  printf '%s\n' "$slice" | tail -n "$n" | _ghw_fmt_log \
    | awk -v p="     $_C_RED┃$_C0 " '{ print p $0 }'
}

# ─── Actions: jobs & steps browser ─────────────────────────────────

# Path to a run's jobs JSON: the persistent copy for a completed run, else
# a fresh fetch (4s TTL, so the steps list of a running job stays live).
_ghw_jobs_json() {
  local id="$1" att="${2:-}" final live
  # Keyed by attempt: a rerun is the same id with a new attempt, and the old
  # attempt's jobs are not this run's jobs any more. A caller that doesn't
  # know the attempt (rerun/cancel prompts) takes the newest cached one.
  [[ -z "$att" ]] && att=$(ls "$CACHE"/run-"$id"-a*.jobs 2>/dev/null | sed 's/.*-a\([0-9]*\)\.jobs$/\1/' | sort -n | tail -1)
  final="$CACHE/run-$id-a${att:-0}.jobs" live="$D/run-$id.jobs"
  if [[ -n "$att" && -s "$final" ]]; then printf '%s\n' "$final"; return; fi
  if [[ ! -s "$live" ]] || (( $(date +%s) - $(_ghw_mtime "$live") > 4 )); then
    gh api "repos/$R/actions/runs/$id/jobs?per_page=100" > "$live.tmp" 2>/dev/null \
      && mv "$live.tmp" "$live"
  fi
  [[ -s "$live" ]] && printf '%s\n' "$live"
}

# The flat jobs › steps list. Job lines are selectable too — their preview
# is the whole job with every failed step expanded in full. Field 2 is the
# kind, which the preview binding uses as its verb (pv-job / pv-step).
_ghw_list_steps() {
  local id="$1" att="${2:-}" f
  f=$(_ghw_jobs_json "$id" "$att") || { printf '%s❌ could not fetch jobs%s\n' "$_C_RED" "$_C0"; return; }
  jq -r --arg run "$id" --arg att "$att" --argjson now "$(date +%s)" \
     --arg C0 "$_C0" --arg CB "$_CB" --arg RED "$_C_RED" --arg YEL "$_C_YEL" --arg DIM "$_C_DIM" \
     "$(_ghw_jq_defs)"'
    .jobs[]
    | (if .status == "completed" then ((.completed_at|secs) - (.started_at|secs))
       elif .started_at != null then ($now - (.started_at|secs)) else null end) as $jd
    | (.status == "completed" and .conclusion == "failure") as $failed
    | ( [ glyph + " " + (if $failed then $CB + $RED elif .status != "completed" then $YEL else $CB end)
          + .name + $C0 + $DIM + "  " + ($jd | dur) + $C0,
          "job", $run, .id, 0, $att ] | @tsv )
    , ( .id as $jid
        | .steps[]
        | (if .status == "completed" then ((.completed_at|secs) - (.started_at|secs))
           elif .started_at != null then ($now - (.started_at|secs)) else null end) as $sd
        | [ "   " + (if .status == "in_progress" then $YEL + "▶ " elif .status != "completed" then $DIM + "○ " else glyph + " " end)
            + (if .conclusion == "failure" then $RED elif .status != "completed" then $DIM else "" end)
            + .name + $C0 + $DIM + "  " + ($sd | dur) + $C0,
            "step", $run, $jid, .number, $att ] | @tsv )
  ' "$f"
}

# One job: header, every step, and every failed step's log in full.
_ghw_pv_job() {
  local run="$1" jid="$2" att="${4:-}" f
  f=$(_ghw_jobs_json "$run" "$att") || return
  local status
  status=$(jq -r --argjson j "$jid" '.jobs[] | select(.id == $j) | .status' "$f")
  jq -r --argjson j "$jid" --argjson now "$(date +%s)" \
     --arg C0 "$_C0" --arg CB "$_CB" --arg RED "$_C_RED" --arg GRN "$_C_GRN" \
     --arg YEL "$_C_YEL" --arg DIM "$_C_DIM" --arg GRY "$_C_GRY" \
     "$(_ghw_jq_defs)"'
    .jobs[] | select(.id == $j)
    | (if .status == "completed" then ((.completed_at|secs) - (.started_at|secs))
       elif .started_at != null then ($now - (.started_at|secs)) else null end) as $jd
    | ( glyph + " " + $CB + .name + $C0 )
    , ( $DIM + (when) + " · " + ($jd | dur) + (if .status != "completed" then " so far" else "" end)
        + (if .runner_name then " · " + .runner_name else "" end) + $C0 )
    , ""
    , ( .steps[]
        | (if .status == "completed" then ((.completed_at|secs) - (.started_at|secs))
           elif .started_at != null then ($now - (.started_at|secs)) else null end) as $sd
        | ( (if .status == "in_progress" then $YEL + "▶ " elif .status != "completed" then $DIM + "○ " else glyph + " " end)
            + (if .conclusion == "failure" then $RED elif .status != "completed" then $DIM else "" end)
            + (.name | trunc(46) | dots(48)) + $C0 + " " + $DIM + ($sd | dur | lpad(6)) + $C0 )
        , ( if .conclusion == "failure" and .started_at != null then
              "\u0001LOG\t\($j)\t\(.number)\t\(.started_at)\t\(.completed_at // "")\t\(.name)"
            else empty end ) )
  ' "$f" | while IFS= read -r line; do
    if [[ "$line" == $'\001LOG\t'* ]]; then
      local j num start end sname
      IFS=$'\t' read -r _ j num start end sname <<< "$line"
      _ghw_step_tail "$j" "$start" "$end" "$sname" 400
    else
      printf '%s\n' "$line"
    fi
  done
  [[ "$status" != "completed" ]] && _ghw_tick 5 'refresh-preview+reload(bash '"$D/w"' list-steps '"$run $att"')'
  return 0
}

# One step: header and its full log.
_ghw_pv_step() {
  local run="$1" jid="$2" num="$3" att="${4:-}" f
  f=$(_ghw_jobs_json "$run" "$att") || return
  local meta name status concl start end jname
  meta=$(jq -r --argjson j "$jid" --argjson n "$num" \
    '.jobs[] | select(.id == $j) | .name as $jn | .steps[] | select(.number == $n)
     | [$jn, .name, .status, (.conclusion // ""), (.started_at // ""), (.completed_at // "")] | @tsv' "$f")
  IFS=$'\t' read -r jname name status concl start end <<< "$meta"
  printf '%s%s%s %s›%s %s%s%s\n' "$_C_GRY" "$jname" "$_C0" "$_C_DIM" "$_C0" "$_CB" "$name" "$_C0"
  local glyph
  glyph=$(jq -rn --arg s "$status" --arg c "$concl" "$(_ghw_jq_defs)"'{status: $s, conclusion: $c} | glyph')
  local dur=""
  [[ -n "$start" && -n "$end" ]] && dur=$(__duration_str "$start" "$end")
  printf '%s %s%s%s%s\n' "$glyph" "$_C_DIM" "${concl:-$status}" "${dur:+ · $dur}" "$_C0"
  _ghw_rule
  case "$status:$concl" in
    completed:skipped) printf '%sskipped%s\n' "$_C_DIM" "$_C0"; return ;;
    completed:*) ;;
    *)
      printf '%s⏳ %s — the log lands when the job completes%s\n' "$_C_YEL" \
        "$(printf '%s' "$status" | tr '_' ' ')" "$_C0"
      _ghw_tick 5 'refresh-preview'
      return ;;
  esac
  local log
  log=$(_ghw_job_log "$jid") || { printf '%slog not available%s\n' "$_C_DIM" "$_C0"; return; }
  _ghw_step_slice "$log" "$start" "$end" "$name" | _ghw_fmt_log
}

# Pager bodies (bound to enter / ctrl-l via execute, piped into less).
_ghw_log_step() { _ghw_pv_step "$@"; }
_ghw_log_job() {
  local jid="$2" f
  f=$(_ghw_job_log "$jid") || { echo "log not available"; return; }
  _ghw_fmt_log < "$f"
}
_ghw_log_run() {
  local run="$1" att="${2:-}" f jid name
  f=$(_ghw_jobs_json "$run" "$att") || return
  # Every job's log, fetched together, printed in job order.
  for jid in $(jq -r '.jobs[] | select(.status == "completed") | .id' "$f"); do
    _ghw_job_log "$jid" >/dev/null 2>&1 &
  done
  wait
  jq -r '.jobs[] | "\(.id)\t\(.name)"' "$f" | while IFS=$'\t' read -r jid name; do
    printf '\n%s%s━━━ %s ━━━%s\n\n' "$_CB" "$_C_PUR" "$name" "$_C0"
    _ghw_log_job _ "$jid"
  done
}

# ─── Actions: rerun / cancel (inside execute, so the prompt has the tty) ──

_ghw_rerun() {
  local id="$1" f failed ans
  f=$(_ghw_jobs_json "$id") || { echo "❌ could not read run $id"; sleep 1.5; return; }
  failed=$(jq '[.jobs[] | select(.conclusion == "failure")] | length' "$f")
  echo ""
  if (( failed > 0 )); then
    read -rp "  ↻ Rerun $failed failed job(s) of run $id? [y/N] " ans
    [[ "$ans" =~ ^[yY]$ ]] || return
    gh run rerun "$id" --failed 2>&1 && echo "  ✅ rerunning failed jobs" || echo "  ❌ rerun failed"
  else
    read -rp "  ↻ Rerun ALL jobs of run $id? [y/N] " ans
    [[ "$ans" =~ ^[yY]$ ]] || return
    gh run rerun "$id" 2>&1 && echo "  ✅ rerun triggered" || echo "  ❌ rerun failed"
  fi
  # A rerun is a new attempt of the same id: the "final" body is final no more.
  rm -f "$CACHE/run-$id".* "$D/run-$id".* "$D"/runs.*.json
  sleep 1.2
}

_ghw_cancel() {
  local id="$1" ans
  echo ""
  read -rp "  ⛔ Cancel run $id? [y/N] " ans
  [[ "$ans" =~ ^[yY]$ ]] || return
  gh run cancel "$id" 2>&1 && echo "  ✅ cancel requested" || echo "  ❌ could not cancel"
  rm -f "$D/run-$id".* "$D"/runs.*.json
  sleep 1.2
}

# ─── Pull requests ─────────────────────────────────────────────────

# Filter modes, cycled by ctrl-f. A file rather than an argument so the
# reload binding is the same string whichever mode is current.
_ghw_prs_mode() { [[ -s "$D/prs.mode" ]] && cat "$D/prs.mode" || echo open; }
_ghw_prs_label() {
  case "$(_ghw_prs_mode)" in
    open)   printf ' open ' ;;
    mine)   printf ' mine ' ;;
    review) printf ' needs my review ' ;;
    merged) printf ' recently merged ' ;;
    closed) printf ' recently closed ' ;;
  esac
}

# ctrl-f: advance the mode and print the new label, synchronously (it is a
# transform-list-label), so the reload that follows reads the new mode.
_ghw_prs_next() {
  local mode
  case "$(_ghw_prs_mode)" in
    open) mode=mine ;; mine) mode=review ;; review) mode=merged ;;
    merged) mode=closed ;; *) mode=open ;;
  esac
  printf '%s' "$mode" > "$D/prs.mode"
  _ghw_prs_label
}

_ghw_list_prs() {
  local mode arg
  mode=$(_ghw_prs_mode)
  for arg in "$@"; do
    [[ "$arg" == fresh ]] && rm -f "$D"/prs.*.json
  done

  local -a flags=(--limit 50 --json 'number,title,author,headRefName,baseRefName,headRefOid,reviewDecision,isDraft,createdAt,updatedAt,additions,deletions,labels,statusCheckRollup,url,state,mergeable')
  case "$mode" in
    open)   flags+=(--state open) ;;
    mine)   flags+=(--state open --author @me) ;;
    review) flags+=(--state open --search 'review-requested:@me') ;;
    merged) flags+=(--state merged) ;;
    closed) flags+=(--state closed) ;;
  esac

  local json="$D/prs.$mode.json"
  if [[ ! -s "$json" ]] || (( $(date +%s) - $(_ghw_mtime "$json") > 30 )); then
    gh pr list "${flags[@]}" > "$json.tmp" 2>/dev/null && mv "$json.tmp" "$json"
  fi
  [[ -s "$json" ]] || { printf '%s❌ could not list pull requests%s\n' "$_C_RED" "$_C0"; return; }

  jq -r --argjson now "$(date +%s)" \
     --arg C0 "$_C0" --arg CB "$_CB" --arg ORG "$_C_ORG" --arg DIM "$_C_DIM" --arg GRY "$_C_GRY" \
     --arg GRN "$_C_GRN" --arg RED "$_C_RED" --arg PUR "$_C_PUR" --arg TAN "$_C_TAN" \
     "$(_ghw_jq_defs)"'
    def review: if .isDraft then "📝" elif .state == "MERGED" then "🟣" elif .state == "CLOSED" then "⛔"
                elif .reviewDecision == "APPROVED" then "✅" elif .reviewDecision == "CHANGES_REQUESTED" then "🔄"
                elif .reviewDecision == "REVIEW_REQUIRED" then "👀" else "⏳" end;
    def ci: (.statusCheckRollup // []) as $c
            | if ($c | length) == 0 then " "
              elif any($c[]; (.conclusion // "") == "FAILURE" or (.state // "") == "FAILURE" or (.state // "") == "ERROR") then $RED + "✗" + $C0
              elif any($c[]; (.status // "") != "COMPLETED" and (.state // "") == "" ) then "…"
              elif any($c[]; (.state // "") == "PENDING" or (.state // "") == "EXPECTED") then "…"
              else $GRN + "✓" + $C0 end;
    if length == 0 then ([$DIM + "  nothing in this view — ctrl-f cycles the filter, ctrl-n opens a PR" + $C0, "none"] | @tsv) else
    ([.[].author.login | length] | max // 4 | if . > 14 then 14 else . end) as $aw
    | .[]
    | [ ( review + " " + ci + " "
          + $DIM + ("#" + (.number|tostring) | rpad(6)) + $C0
          + $TAN + (.author.login | trunc($aw) | rpad($aw)) + $C0 + "  "
          + $DIM + (($now - (.updatedAt|secs)) | age | lpad(3)) + $C0 + "  "
          + (.title | gsub("[\t\n]"; " "))
          + $DIM + "  " + $ORG + .headRefName + $C0
          + $DIM + "  " + $GRN + "+" + (.additions|tostring) + $RED + "/-" + (.deletions|tostring) + $C0 ),
        .number, .url, .headRefName, .headRefOid, .state, .title ] | @tsv end
  ' "$json"
}

# The PR preview: everything `gh pr view` says, in colour and in an order
# that answers "can I merge this" first.
_ghw_pv_pr() {
  [[ "$1" == none || -z "$1" ]] && {
    printf '%sNothing in this view.\n\nctrl-f cycles: open → mine → needs my review → merged → closed\nctrl-n opens a pull request from the current branch%s\n' "$_C_DIM" "$_C0"; return; }
  local num="$1" f="$D/pr-$1.json"
  if [[ ! -s "$f" ]] || (( $(date +%s) - $(_ghw_mtime "$f") > 45 )); then
    gh pr view "$num" --json 'number,title,state,author,body,baseRefName,headRefName,reviewDecision,isDraft,mergeable,mergeStateStatus,additions,deletions,changedFiles,labels,reviews,reviewRequests,statusCheckRollup,createdAt,updatedAt,url,assignees,commits,comments,milestone' \
      > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
  fi
  [[ -s "$f" ]] || { printf '%s❌ could not read PR #%s%s\n' "$_C_RED" "$num" "$_C0"; return; }

  jq -r --argjson now "$(date +%s)" \
     --arg C0 "$_C0" --arg CB "$_CB" --arg ORG "$_C_ORG" --arg DIM "$_C_DIM" --arg GRY "$_C_GRY" \
     --arg GRN "$_C_GRN" --arg RED "$_C_RED" --arg PUR "$_C_PUR" --arg TAN "$_C_TAN" --arg YEL "$_C_YEL" \
     --arg BLU "$_C_BLU" \
     "$(_ghw_jq_defs)"'
    def state: if .isDraft then $DIM + "📝 draft" elif .state == "MERGED" then $PUR + "🟣 merged"
               elif .state == "CLOSED" then $RED + "⛔ closed" else $GRN + "🟢 open" end;
    def decision: if .state != "OPEN" and .reviewDecision != "APPROVED" and .reviewDecision != "CHANGES_REQUESTED" then empty
                  elif .reviewDecision == "APPROVED" then $GRN + "✅ approved"
                  elif .reviewDecision == "CHANGES_REQUESTED" then $YEL + "🔄 changes requested"
                  elif .reviewDecision == "REVIEW_REQUIRED" then $YEL + "👀 review required"
                  else $DIM + "no review decision" end;
    def mergeable: if .state != "OPEN" then empty
                   elif .mergeable == "CONFLICTING" then $RED + "⚠  merge conflicts" + $C0
                   elif .mergeStateStatus == "CLEAN" then $GRN + "✔ ready to merge" + $C0
                   elif .mergeStateStatus == "BLOCKED" then $YEL + "⛔ blocked by rules" + $C0
                   elif .mergeStateStatus == "BEHIND" then $YEL + "↓ behind base" + $C0
                   elif .mergeStateStatus == "UNSTABLE" then $YEL + "✗ checks failing" + $C0
                   elif .mergeStateStatus == "DIRTY" then $RED + "⚠  conflicts" + $C0
                   else $DIM + (.mergeStateStatus | ascii_downcase) + $C0 end;
    def check: (.conclusion // .state // .status // "") | ascii_upcase
               | if . == "SUCCESS" then "✅" elif . == "FAILURE" or . == "ERROR" then "❌"
                 elif . == "SKIPPED" or . == "NEUTRAL" then "⏭ " elif . == "CANCELLED" then "🚫"
                 elif . == "PENDING" or . == "EXPECTED" or . == "IN_PROGRESS" or . == "QUEUED" or . == "" then "⏳"
                 else "❓" end;
    ( $CB + .title + $C0 + $DIM + "  #" + (.number|tostring) + $C0 )
    , ( (state) + $C0 + $DIM + " · " + $C0 + $TAN + .author.login + $C0 + $DIM + " · "
        + $ORG + .headRefName + $C0 + $DIM + " → " + $ORG + .baseRefName + $C0 + $DIM
        + " · updated " + (($now - (.updatedAt|secs)) | age) + " ago" + $C0 )
    , ( $GRN + "+" + (.additions|tostring) + $RED + " -" + (.deletions|tostring) + $C0 + $DIM
        + " · " + (.changedFiles|tostring) + " files · " + (.commits|length|tostring) + " commits · "
        + (.comments|length|tostring) + " comments" + $C0 )
    , ( if (.labels|length) > 0 then "🏷  " + ([.labels[].name | $BLU + . + $C0] | join("  ")) else empty end )
    , ""
    , ( (decision) + $C0
        + (if (.reviewRequests|length) > 0 then $DIM + " · awaiting " + ([.reviewRequests[] | (.login // .name // "?")] | join(", ")) + $C0 else "" end) )
    , ( ([.reviews[]? | select(.state != "COMMENTED")] | group_by(.author.login) | map(last) | .[]
        | "   " + (if .state == "APPROVED" then "✅" elif .state == "CHANGES_REQUESTED" then "🔄" elif .state == "DISMISSED" then "⚪" else "💬" end)
          + " " + .author.login + $DIM + " " + (.state | ascii_downcase | gsub("_"; " ")) + $C0 ) )
    , ( mergeable )
    , ( if (.statusCheckRollup|length) > 0 then
          ( "", $GRY + "checks" + $C0,
            ( .statusCheckRollup[] | "   " + check + " " + (.name // .context // "?")
              + (if .startedAt and .completedAt then $DIM + " " + (((.completedAt|secs) - (.startedAt|secs)) | dur) + $C0 else "" end) ) )
        else empty end )
    , ""
    , ( if (.body // "") != "" then ($DIM + "────────────────────────────────────────────────────────" + $C0, (.body | gsub("\r"; ""))) else $DIM + "(no description)" + $C0 end )
  ' "$f"

  # Live while checks are still running on an open PR.
  if jq -e '.state == "OPEN" and any(.statusCheckRollup[]?; (.status // "") != "COMPLETED" and (.state // "") != "SUCCESS" and (.state // "") != "FAILURE" and (.state // "") != "ERROR")' "$f" >/dev/null 2>&1; then
    rm -f "$f"; _ghw_tick 8 'refresh-preview'
  fi
}

# ─── Branches ──────────────────────────────────────────────────────

# Remote branches from the API (authoritative, carries `protected`), joined
# with what local git knows about each — age, author, subject, ahead/behind
# the default branch — which is instant. A fetch runs in the background on a
# fresh load and reloads the list when done, so the local view catches up
# without holding the screen.
_ghw_list_branches() {
  local arg fresh=""
  for arg in "$@"; do [[ "$arg" == fresh ]] && fresh=1; done
  local json="$D/branches.json"
  if [[ -n "$fresh" || ! -s "$json" ]] || (( $(date +%s) - $(_ghw_mtime "$json") > 60 )); then
    gh api "repos/$R/branches?per_page=100" --paginate > "$json.tmp" 2>/dev/null && mv "$json.tmp" "$json"
    # --paginate concatenates arrays; flatten so it is one list.
    jq -s 'flatten' "$json" > "$json.tmp" 2>/dev/null && mv "$json.tmp" "$json"
    (
      git fetch --prune -q origin >/dev/null 2>&1 \
        && _ghw_notify 'reload(bash '"$D/w"' list-branches)' "${FZF_PORT:-}"
    ) >/dev/null 2>&1 </dev/null &
  fi
  [[ -s "$json" ]] || { printf '%s❌ could not list branches%s\n' "$_C_RED" "$_C0"; return; }

  local def cur
  def=$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null)
  cur=$(git symbolic-ref --short HEAD 2>/dev/null)

  # Local facts, one git call: for every remote-tracking ref, its age,
  # author, subject and ahead/behind against the default branch.
  local facts="$D/branches.facts"
  # %(ahead-behind:) needs git ≥ 2.41; older gits get the columns without it.
  # lstrip=3 drops refs/remotes/origin/ so the name matches the API's.
  local fmt='%(refname:lstrip=3)%09%(committerdate:unix)%09%(authorname)%09%(subject)%09'
  git for-each-ref --format="$fmt"'%(ahead-behind:refs/remotes/origin/'"$def"')' refs/remotes/origin > "$facts" 2>/dev/null \
    || git for-each-ref --format="$fmt" refs/remotes/origin > "$facts" 2>/dev/null

  jq -r --arg def "$def" --arg cur "$cur" --argjson now "$(date +%s)" \
     --rawfile facts "$facts" \
     --arg C0 "$_C0" --arg CB "$_CB" --arg ORG "$_C_ORG" --arg DIM "$_C_DIM" --arg GRY "$_C_GRY" \
     --arg GRN "$_C_GRN" --arg RED "$_C_RED" --arg TAN "$_C_TAN" --arg YEL "$_C_YEL" \
     "$(_ghw_jq_defs)"'
    ($facts | split("\n") | map(select(length > 0) | split("\t") | {(.[0]): {t: .[1], who: .[2], subj: .[3], ab: (.[4] // "")}}) | add // {}) as $F
    | ([.[].name | length] | max // 4 | if . > 28 then 28 else . end) as $nw
    | sort_by(if .name == $def then 0 else 1 end, -(($F[.name].t // "0") | tonumber))
    | .[]
    | $F[.name] as $f
    | (($f.ab // "") | split(" ")) as $ab
    | [ ( (if .name == $cur then $ORG + "●" else " " end) + $C0 + " "
          + (if .name == $def then "⭐" elif .protected then "🛡 " else "  " end) + " "
          + (if .name == $cur then $ORG + $CB else "" end) + (.name | trunc($nw) | rpad($nw)) + $C0 + "  "
          + (if $f then
               $DIM + ((($now - ($f.t|tonumber)) | age) | lpad(3)) + $C0 + "  "
               + (if .name == $def then "        "
                  else ($GRN + "↑" + ($ab[0] // "?" | lpad(3)) + " " + $RED + "↓" + ($ab[1] // "?" | lpad(3)) + $C0) end) + "  "
               + $TAN + ($f.who | trunc(12) | rpad(12)) + $C0 + "  " + ($f.subj | gsub("[\t\n]"; " "))
             else $DIM + "  (not fetched yet)" + $C0 end) ),
        .name, (if .protected then 1 else 0 end), (if .name == $def then 1 else 0 end),
        (if .name == $cur then 1 else 0 end), .commit.sha ] | @tsv
  ' "$json"
}

_ghw_pv_branch() {
  local name="$1" protected="$2" isdef="$3" iscur="$4"
  [[ "$name" == none || -z "$name" ]] && return 0
  printf '%s%s%s' "$_CB$_C_ORG" "$name" "$_C0"
  (( isdef )) && printf '  %s⭐ default%s' "$_C_YEL" "$_C0"
  (( iscur )) && printf '  %s● checked out%s' "$_C_ORG" "$_C0"
  (( protected )) && printf '  %s🛡  ruled%s' "$_C_BLU" "$_C0"
  printf '\n'

  # Local tracking state, if we have it.
  local up
  if git show-ref --verify --quiet "refs/heads/$name" 2>/dev/null; then
    up=$(git rev-parse --abbrev-ref "$name@{upstream}" 2>/dev/null)
    if [[ -n "$up" ]]; then
      local ahead behind
      read -r ahead behind < <(git rev-list --left-right --count "$name...$up" 2>/dev/null)
      printf '%slocal branch · ↑%s ↓%s vs %s%s\n' "$_C_DIM" "${ahead:-?}" "${behind:-?}" "$up" "$_C0"
    else
      printf '%slocal branch · no upstream%s\n' "$_C_DIM" "$_C0"
    fi
  else
    printf '%sremote only — enter to check out%s\n' "$_C_DIM" "$_C0"
  fi

  # The PR for this branch, if any.
  local pr
  pr=$(gh pr list --head "$name" --state all --limit 1 \
        --json number,title,state,isDraft,url --jq '.[0] | select(.) |
        "\(if .state == "MERGED" then "🟣" elif .state == "CLOSED" then "⛔" elif .isDraft then "📝" else "🟢" end) #\(.number)  \(.title)"' 2>/dev/null)
  [[ -n "$pr" ]] && printf '%s\n' "$pr"

  # Effective rules — cached: rulesets change rarely and this is two calls.
  local rf="$D/rules-$name"
  if [[ ! -s "$rf" ]] || (( $(date +%s) - $(_ghw_mtime "$rf") > 300 )); then
    gh api "repos/$R/rules/branches/$name" 2>/dev/null | jq -r --arg DIM "$_C_DIM" --arg C0 "$_C0" '
      if length == 0 then empty else
        "rules: " + ([.[] | .type
          + (if .type == "required_status_checks" then " (\(.parameters.required_status_checks | length) checks" + (if .parameters.strict_required_status_checks_policy then ", strict" else "" end) + ")"
             elif .type == "pull_request" then " (\(.parameters.required_approving_review_count) approvals)"
             else "" end)] | unique | join(" · "))
      end' > "$rf" 2>/dev/null
  fi
  [[ -s "$rf" ]] && printf '%s🛡  %s%s\n' "$_C_BLU" "$(<"$rf")" "$_C0"

  _ghw_rule
  local ref="origin/$name"
  git rev-parse --verify --quiet "$ref" >/dev/null 2>&1 || ref="$name"
  git log --color=always --format='%C(215)%h%C(reset) %C(240)%ar%C(reset) %C(180)%an%C(reset) %s%C(auto)%d%C(reset)' \
    -n 20 "$ref" 2>/dev/null || printf '%s(no local commits for %s — fetch first)%s\n' "$_C_DIM" "$name" "$_C0"
}

# ─── Secrets ───────────────────────────────────────────────────────

_ghw_list_secrets() {
  local arg
  for arg in "$@"; do [[ "$arg" == fresh ]] && rm -f "$D"/secrets.json; done
  local json="$D/secrets.json"
  if [[ ! -s "$json" ]] || (( $(date +%s) - $(_ghw_mtime "$json") > 60 )); then
    {
      gh secret list --json name,updatedAt --jq '.[] | {scope: "repo", env: "", name, updatedAt}' 2>/dev/null
      gh api "repos/$R/environments" --jq '.environments[].name' 2>/dev/null | while read -r env; do
        gh secret list --env "$env" --json name,updatedAt \
          --jq --arg env "$env" '.[] | {scope: "env", env: $env, name, updatedAt}' 2>/dev/null
      done
    } | jq -s '.' > "$json.tmp" 2>/dev/null && mv "$json.tmp" "$json"
  fi
  [[ -s "$json" ]] || { printf '%s❌ could not list secrets%s\n' "$_C_RED" "$_C0"; return; }
  jq -r --argjson now "$(date +%s)" \
     --arg C0 "$_C0" --arg CB "$_CB" --arg DIM "$_C_DIM" --arg PUR "$_C_PUR" --arg TAN "$_C_TAN" \
     "$(_ghw_jq_defs)"'
    if length == 0 then [ $DIM + "  no secrets — ctrl-n sets one" + $C0, "none", "", "" ] | @tsv else
    ([.[].name | length] | max) as $nw
    | .[]
    | [ ( (if .scope == "repo" then "🔑 " else "🌍 " end)
          + $CB + (.name | rpad($nw)) + $C0 + "  "
          + (if .scope == "env" then $PUR + .env + $C0 + "  " else "" end)
          + $DIM + "updated " + (($now - (.updatedAt|secs)) | age) + " ago" + $C0 ),
        .scope, .env, .name ] | @tsv end
  ' "$json"
}

_ghw_pv_secret() {
  local scope="$1" env="$2" name="$3"
  [[ "$scope" == none ]] && { printf '%sNothing here yet.\n\nctrl-n sets a repository or environment secret.%s\n' "$_C_DIM" "$_C0"; return; }
  printf '%s%s%s\n' "$_CB" "$name" "$_C0"
  if [[ "$scope" == repo ]]; then
    printf '%srepository secret%s\n' "$_C_DIM" "$_C0"
  else
    printf '%senvironment secret · %s%s%s\n' "$_C_DIM" "$_C_PUR" "$env" "$_C0"
  fi
  _ghw_rule
  cat <<TXT
${_C_GRY}Values are write-only. GitHub never returns them — not to the API,
not to the CLI. To change one, set it again (ctrl-n with the same name).${_C0}

${_C_DIM}Used in a workflow as${_C0}  \${{ secrets.$name }}
TXT
  if [[ "$scope" == env ]]; then
    printf '%swhich resolves only in a job that declares%s  environment: %s\n' "$_C_DIM" "$_C0" "$env"
  fi
}

# ─── Environments ──────────────────────────────────────────────────

_ghw_list_envs() {
  local arg
  for arg in "$@"; do [[ "$arg" == fresh ]] && rm -f "$D"/envs.json; done
  local json="$D/envs.json"
  if [[ ! -s "$json" ]] || (( $(date +%s) - $(_ghw_mtime "$json") > 60 )); then
    gh api "repos/$R/environments" > "$json.tmp" 2>/dev/null && mv "$json.tmp" "$json"
  fi
  [[ -s "$json" ]] || { printf '%s❌ could not list environments%s\n' "$_C_RED" "$_C0"; return; }
  jq -r --argjson now "$(date +%s)" \
     --arg C0 "$_C0" --arg CB "$_CB" --arg DIM "$_C_DIM" --arg PUR "$_C_PUR" \
     "$(_ghw_jq_defs)"'
    (.environments // []) as $e
    | if ($e | length) == 0 then [ $DIM + "  no environments — ctrl-n creates one" + $C0, "none" ] | @tsv else
      ([$e[].name | length] | max) as $nw
      | $e[]
      | [ ( "🌍 " + $CB + (.name | rpad($nw)) + $C0 + "  "
            + $DIM + "created " + (($now - (.created_at|secs)) | age) + " ago"
            + (if (.protection_rules|length) > 0 then " · \(.protection_rules|length) protection rule(s)" else "" end) + $C0 ),
          .name ] | @tsv end
  ' "$json"
}

_ghw_pv_env() {
  local name="$1"
  [[ "$name" == none ]] && { printf '%sNothing here yet.\n\nctrl-n creates an environment.%s\n' "$_C_DIM" "$_C0"; return; }
  local f="$D/env-$name.json"
  if [[ ! -s "$f" ]] || (( $(date +%s) - $(_ghw_mtime "$f") > 60 )); then
    gh api "repos/$R/environments/$name" > "$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
  fi
  printf '%s🌍 %s%s\n' "$_CB" "$name" "$_C0"
  [[ -s "$f" ]] || { printf '%s❌ could not read environment%s\n' "$_C_RED" "$_C0"; return; }
  jq -r --arg C0 "$_C0" --arg DIM "$_C_DIM" --arg YEL "$_C_YEL" --arg GRY "$_C_GRY" '
    ($DIM + "created " + .created_at[:10] + " · updated " + .updated_at[:10] + $C0),
    "",
    ($GRY + "protection rules" + $C0),
    (if (.protection_rules|length) == 0 then $DIM + "   none — any job may deploy here" + $C0
     else .protection_rules[]
       | if .type == "wait_timer" then "   ⏱  wait \(.wait_timer) min before deploying"
         elif .type == "required_reviewers" then "   👤 reviewers: \([.reviewers[].reviewer.login] | join(", "))" + (if .prevent_self_review then " (no self-review)" else "" end)
         elif .type == "branch_policy" then "   🌿 deployment branch policy"
         else "   \(.type)" end end),
    (if .deployment_branch_policy then
       (if .deployment_branch_policy.protected_branches then "   🌿 only protected branches may deploy"
        elif .deployment_branch_policy.custom_branch_policies then "   🌿 only selected branches/tags may deploy"
        else empty end)
     else "   🌿 any branch may deploy" end)
  ' "$f"
  echo ""
  printf '%ssecrets%s\n' "$_C_GRY" "$_C0"
  local s
  s=$(gh secret list --env "$name" --json name,updatedAt --jq '.[] | "   🔑 \(.name)"' 2>/dev/null)
  printf '%s\n' "${s:-   ${_C_DIM}none${_C0}}"
  echo ""
  printf '%srecent deployments%s\n' "$_C_GRY" "$_C0"
  local d
  d=$(gh api "repos/$R/deployments?environment=$(printf '%s' "$name" | jq -sRr @uri)&per_page=5" 2>/dev/null \
      | jq -r --arg DIM "$_C_DIM" --arg C0 "$_C0" '.[] | "   " + (.created_at[:16] | gsub("T"; " ")) + " " + $DIM + .ref + " · " + (.creator.login // "?") + $C0' 2>/dev/null)
  printf '%s\n' "${d:-   ${_C_DIM}none${_C0}}"
}

# ─── Hub ───────────────────────────────────────────────────────────

# Everything the hub's previews and header show, fetched in parallel and
# written pane by pane. Each pane POSTs a refresh as it lands, so the hub is
# on screen instantly and fills in over the next second rather than opening
# a second late. `$1` is the file the hub's own preview writes FZF_PORT to.
_ghw_hub_prefetch() {
  local portf="$1"
  _hub_done() {   # <pane>
    local port=""
    [[ -s "$portf" ]] && port=$(<"$portf")
    _ghw_notify 'refresh-preview' "$port"
  }
  (
    {
      gh pr list --limit 8 --state open --json number,title,reviewDecision,isDraft,author,updatedAt \
        --jq --arg C0 "$_C0" --arg DIM "$_C_DIM" --arg TAN "$_C_TAN" '
          if length == 0 then $DIM + "no open pull requests" + $C0 else
          .[] | "\(if .isDraft then "📝" elif .reviewDecision == "APPROVED" then "✅"
                   elif .reviewDecision == "CHANGES_REQUESTED" then "🔄" else "⏳" end) " + $DIM + "#\(.number)" + $C0
                + "  \(.title)  " + $TAN + .author.login + $C0 end' 2>/dev/null
    } > "$D/hub.prs.tmp"; mv "$D/hub.prs.tmp" "$D/hub.prs"; _hub_done prs
  ) &
  (
    {
      local sha br
      sha=$(git rev-parse HEAD 2>/dev/null); br=$(git symbolic-ref --short HEAD 2>/dev/null)
      printf '%sHEAD %s%s%s on %s%s%s\n\n' "$_C_DIM" "$_C0" "${sha:0:7}" "$_C_DIM" "$_C_ORG" "${br:-detached}" "$_C0"
      gh api "repos/$R/commits/$sha/check-runs" 2>/dev/null \
        | jq -r --argjson now "$(date +%s)" --arg C0 "$_C0" --arg DIM "$_C_DIM" "$(_ghw_jq_defs)"'
            # Latest run of each check name: a rerun on the same commit reports
            # every check twice, and the GitHub UI itself shows the newest.
            ((.check_runs // []) | group_by(.name) | map(max_by(.started_at // ""))) as $c
            | if ($c|length) == 0 then $DIM + "no checks reported for HEAD" + $C0 else
              ($c | map(select(.conclusion == "success")) | length) as $ok
              | ($c | map(select(.conclusion == "failure")) | length) as $bad
              | ($c | map(select(.status != "completed")) | length) as $run
              | ( (if $bad > 0 then "❌ \($bad) failed  " else "" end)
                + (if $run > 0 then "⏳ \($run) running  " else "" end)
                + (if $ok > 0 then "✅ \($ok) passed" else "" end) )
              , ""
              , ( $c[] | glyph + " " + .name
                  + (if .started_at and .completed_at then $DIM + "  " + (((.completed_at|secs) - (.started_at|secs)) | dur) + $C0 else "" end) )
              end'
    } > "$D/hub.ci.tmp" 2>/dev/null; mv "$D/hub.ci.tmp" "$D/hub.ci"; _hub_done ci
  ) &
  (
    {
      local def br
      def=$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null)
      br=$(git symbolic-ref --short HEAD 2>/dev/null)
      printf '%sdefault %s%s%s · on %s%s%s\n\n' "$_C_DIM" "$_C0" "$def" "$_C_DIM" "$_C_ORG" "${br:-detached}" "$_C0"
      gh api "repos/$R/branches?per_page=100" --paginate 2>/dev/null | jq -r --arg def "$def" '
        .[] | (if .name == $def then "⭐ " elif .protected then "🛡  " else "   " end) + .name' 2>/dev/null | head -25
    } > "$D/hub.branches.tmp"; mv "$D/hub.branches.tmp" "$D/hub.branches"; _hub_done branches
  ) &
  (
    {
      local n
      n=$(gh secret list --json name --jq 'length' 2>/dev/null)
      printf '%s%s repository secret(s)%s\n' "$_C_DIM" "${n:-0}" "$_C0"
      gh secret list --json name,updatedAt --jq '.[] | "🔑 \(.name)"' 2>/dev/null
    } > "$D/hub.secrets.tmp"; mv "$D/hub.secrets.tmp" "$D/hub.secrets"; _hub_done secrets
  ) &
  (
    {
      gh api "repos/$R/environments" --jq --arg DIM "$_C_DIM" --arg C0 "$_C0" '
        if (.environments|length) == 0 then $DIM + "no environments" + $C0 else
        .environments[] | "🌍 \(.name)" + (if (.protection_rules|length) > 0 then $DIM + "  \(.protection_rules|length) rule(s)" + $C0 else "" end) end' 2>/dev/null
    } > "$D/hub.envs.tmp"; mv "$D/hub.envs.tmp" "$D/hub.envs"; _hub_done envs
  ) &
  (
    {
      # The header line: visibility, default branch, open PR count, HEAD CI.
      local meta vis def prs
      meta=$(gh repo view --json visibility,defaultBranchRef,stargazerCount 2>/dev/null)
      vis=$(jq -r '.visibility | ascii_downcase' <<< "$meta" 2>/dev/null)
      def=$(jq -r '.defaultBranchRef.name' <<< "$meta" 2>/dev/null)
      prs=$(gh pr list --state open --json number --jq 'length' 2>/dev/null)
      printf '%s · %s%s%s · %s open PR(s)' \
        "$(if [[ "$vis" == public ]]; then printf '🌍 public'; else printf '🔒 %s' "${vis:-private}"; fi)" \
        "$_C_ORG" "${def:-?}" "$_C0" "${prs:-0}"
    } > "$D/hub.header.tmp"; mv "$D/hub.header.tmp" "$D/hub.header"
    local port=""; [[ -s "$portf" ]] && port=$(<"$portf")
    _ghw_notify "change-list-label: $(<"$D/hub.header") " "$port"
  ) &
  wait
}

_ghw_pv_hub() {
  local pane="$1"
  # Publish our port for the prefetch running alongside us.
  [[ -n "${FZF_PORT:-}" ]] && printf '%s' "$FZF_PORT" > "$D/hub.port"
  case "$pane" in
    *Actions*)       pane=ci ;;
    *Pull*)          pane="prs" ;;
    *Branches*)      pane=branches ;;
    *Secrets*)       pane=secrets ;;
    *Environments*)  pane=envs ;;
    *) return ;;
  esac
  if [[ -s "$D/hub.$pane" ]]; then
    cat "$D/hub.$pane"
  else
    printf '%s⏳ loading…%s\n' "$_C_DIM" "$_C0"
  fi
}

