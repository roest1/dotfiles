}

_ghw_env_menu() {
  local name="$1" action
  [[ -z "$name" || "$name" == none ]] && return 0
  while true; do
    action=$(printf '%s\n' \
      "⏱  Set wait timer" \
      "👤 Set required reviewers" \
      "🔑 Set a secret here" \
      "🗑  Delete environment" \
      "🌐 Open in browser" \
      | FZF_MENU_HELP="$_GH_D/help/envs" _gh_menu "$name" \
          --border-label=" 🌍 $name " \
          --preview="bash '$_GH_W' pv-env '$name'" "${_GH_PREVIEW[@]}")
    [[ -z "$action" ]] && return 0
    rm -f "$_GH_D/env-$name.json"
    case "$action" in
      *"wait timer"*)
        local minutes
        minutes=$(_gh_input "Wait before deploying, in minutes (0 disables):")
        if [[ "$minutes" =~ ^[0-9]+$ ]]; then
          gh api -X PUT "repos/$R/environments/$name" \
            --input <(jq -n --argjson m "$minutes" '{wait_timer: $m}') --silent 2>/dev/null \
            && echo "  ✅ wait timer: ${minutes}m" || echo "  ❌ failed — needs admin"
          sleep 1.2
        fi ;;
      *reviewers*)
        local collabs reviewer uid
        collabs=$(gh api "repos/$R/collaborators" --jq '.[].login' 2>/dev/null)
        if [[ -n "$collabs" ]]; then
          reviewer=$(printf '%s\n' "$collabs" \
            | _gh_fzf envs --border-label=" 👤 required reviewer " --header="enter select   esc back")
        fi
        [[ -z "$reviewer" ]] && reviewer=$(_gh_input "Reviewer username:")
        [[ -z "$reviewer" ]] && continue
        uid=$(gh api "users/$reviewer" --jq '.id' 2>/dev/null)
        if [[ -n "$uid" ]]; then
          gh api -X PUT "repos/$R/environments/$name" \
            --input <(jq -n --argjson uid "$uid" '{reviewers: [{type: "User", id: $uid}]}') --silent 2>/dev/null \
            && echo "  ✅ reviewer: $reviewer" || echo "  ❌ failed — needs admin"
        else
          echo "  ❌ no GitHub user '$reviewer'"
        fi
        sleep 1.2 ;;
      *secret*)    _ghw_secret_set env "$name" ;;
      *Delete*)    _ghw_env_delete "$name"; return 0 ;;
      *browser*)   _ghw_open_settings "environments" ;;
    esac
  done
}

