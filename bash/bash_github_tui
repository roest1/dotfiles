_ghw_open_settings() { _open_url "https://github.com/$R/settings/$1"; }

# ── pull requests ──

_ghw_pr_checkout() {
  local num="$1"
  [[ "$num" == none || -z "$num" ]] && return 0
  echo ""
  gh pr checkout "$num" && echo "  ✅ checked out PR #$num" || echo "  ❌ checkout failed"
  sleep 1.2
}

_ghw_pr_create() {
  local cur def
  cur=$(git symbolic-ref --short HEAD 2>/dev/null)
  def=$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null)
  if [[ "$cur" == "$def" ]]; then
    echo ""; echo "  ❌ you're on '$def' — switch to a feature branch first"; sleep 2; return
  fi
  local kind
  kind=$(printf '%s\n' "Ready for review" "Draft" \
    | _gh_menu "New PR: $cur → $def" --border-label=" ➕ create pull request ")
  [[ -z "$kind" ]] && return
  echo ""
  if [[ "$kind" == Draft ]]; then gh pr create --draft; else gh pr create; fi
  _gh_pause
}

# The per-PR action menu. Everything a PR can have done to it, from one
# place; each action returns here, -/q returns to the list.
_ghw_pr_menu() {
  local num="$1"
  [[ "$num" == none || -z "$num" ]] && return 0
  local title action
  title=$(gh pr view "$num" --json title -q .title 2>/dev/null)
  while true; do
    action=$(printf '%s\n' \
      "📥 Checkout locally" \
      "📝 Diff" \
      "📊 Changed files" \
      "💬 Comment" \
      "✅ Approve" \
      "🔄 Request changes" \
      "🏷  Labels" \
      "👤 Reviewers" \
      "✏️  Edit title / body" \
      "🔀 Merge" \
      "🔁 Mark ready / draft" \
      "❌ Close" \
      "🌐 Open in browser" \
      | FZF_MENU_HELP="$_GH_D/help/prs" _gh_menu "PR #$num" \
          --border-label=" 🔀 #$num  $title " \
          --preview="bash '$_GH_W' pv-pr $num" "${_GH_PREVIEW[@]}")
    [[ -z "$action" ]] && return 0
    rm -f "$_GH_D/pr-$num.json"   # every action below may change the preview
    case "$action" in
      *Checkout*)   _ghw_pr_checkout "$num" ;;
      *Diff*)       gh pr diff "$num" --color=always | less -R ;;
      *"Changed files"*) _ghw_pr_files "$num" ;;
      *Comment*)    _ghw_pr_comment "$num" ;;
      *Approve*)
        local msg
        msg=$(_gh_input "Approval message (optional):")
        if [[ -n "$msg" ]]; then gh pr review "$num" --approve --body "$msg"
        else gh pr review "$num" --approve; fi && { echo "  ✅ approved #$num"; sleep 1; } ;;
      *"Request changes"*)
        local tmpfile
        tmpfile=$(mktemp "${TMPDIR:-/tmp}/pr-review-XXXXXX.md")
        ${EDITOR:-vi} "$tmpfile"
        if [[ -s "$tmpfile" ]]; then
          gh pr review "$num" --request-changes --body-file "$tmpfile" && { echo "  ✅ changes requested"; sleep 1; }
        fi
        rm -f "$tmpfile" ;;
      *Labels*)     _ghw_pr_labels "$num" ;;
      *Reviewers*)  _ghw_pr_reviewers "$num" ;;
      *"Edit title"*)
        _ghw_pr_edit "$num"
        title=$(gh pr view "$num" --json title -q .title 2>/dev/null) ;;
      *Merge*)      _ghw_pr_merge "$num" ;;
      *"Mark ready"*)
        if [[ "$(gh pr view "$num" --json isDraft -q .isDraft)" == true ]]; then
          gh pr ready "$num" && { echo "  ✅ marked ready for review"; sleep 1; }
        else
          gh pr ready --undo "$num" && { echo "  ✅ converted to draft"; sleep 1; }
        fi ;;
      *Close*)
        _gh_confirm "Close PR #$num without merging?" "Close it" "Keep it open" || continue
        gh pr close "$num" && { echo "  ✅ closed #$num"; sleep 1; } ;;
      *browser*)    gh pr view "$num" --web ;;
    esac
  done
}

_ghw_pr_files() {
  local num="$1"
  gh pr diff "$num" --name-only 2>/dev/null \
    | _gh_fzf prs --border-label=" 📊 files changed in #$num " \
        --header="enter pages the diff for one file   esc back" \
        --preview="gh pr diff $num -- {} --color=always" \
        --bind="enter:execute(gh pr diff $num -- {} --color=always | less -R)" >/dev/null
  return 0
}

_ghw_pr_comment() {
  local num="$1" body="" tmpfile
  tmpfile=$(mktemp "${TMPDIR:-/tmp}/pr-comment-XXXXXX.md")
  ${EDITOR:-vi} "$tmpfile"
  body=$(cat "$tmpfile"); rm -f "$tmpfile"
  [[ -n "$body" ]] && gh pr comment "$num" --body "$body" && { echo "  ✅ comment added"; sleep 1; }
}

_ghw_pr_merge() {
  local num="$1"
  local mergeable
  mergeable=$(gh pr view "$num" --json mergeable -q .mergeable 2>/dev/null)
  if [[ "$mergeable" == "CONFLICTING" ]]; then
    echo ""; echo "  ⚠️  PR has merge conflicts — resolve before merging"; sleep 2; return
  fi
  local strategy
  strategy=$(printf '%s\n' \
    "Squash and merge   (one commit, clean history)" \
    "Merge commit       (keeps every commit)" \
    "Rebase and merge   (linear, no merge commit)" \
    | _gh_menu "Merge #$num" --border-label=" 🔀 merge strategy ")
  [[ -z "$strategy" ]] && return
  local flag
  case "$strategy" in
    Squash*) flag="--squash" ;;
    Merge*)  flag="--merge" ;;
    Rebase*) flag="--rebase" ;;
  esac
  local del=""
  _gh_confirm "Delete the branch after merging?" "Delete branch" "Keep branch" && del="--delete-branch"
  echo ""
  # shellcheck disable=SC2086  # $del is a flag or empty
  gh pr merge "$num" "$flag" $del \
    && echo "  ✅ merged #$num" || echo "  ❌ merge failed — check requirements"
  sleep 1.5
}

_ghw_pr_labels() {
  local num="$1" current action
  current=$(gh pr view "$num" --json labels --jq '.labels[].name' 2>/dev/null)
  action=$(printf '%s\n' "Add labels" "Remove labels" \
    | _gh_menu "Labels on #$num: ${current:-none}" --border-label=" 🏷  labels ")
  [[ -z "$action" ]] && return
  local pick joined
  case "$action" in
    "Add labels")
      pick=$(gh label list --json name --jq '.[].name' 2>/dev/null \
        | _gh_fzf prs --multi --border-label=" 🏷  add labels " \
            --header="tab toggles   enter applies   esc back")
      [[ -z "$pick" ]] && return
      joined=$(printf '%s\n' "$pick" | paste -sd,)
      gh pr edit "$num" --add-label "$joined" && { echo "  ✅ added: $joined"; sleep 1; } ;;
    "Remove labels")
      [[ -z "$current" ]] && return
      pick=$(printf '%s\n' "$current" \
        | _gh_fzf prs --multi --border-label=" 🏷  remove labels " \
            --header="tab toggles   enter applies   esc back")
      [[ -z "$pick" ]] && return
      joined=$(printf '%s\n' "$pick" | paste -sd,)
      gh pr edit "$num" --remove-label "$joined" && { echo "  ✅ removed: $joined"; sleep 1; } ;;
  esac
}

_ghw_pr_reviewers() {
  local num="$1" collabs pick joined
  collabs=$(gh api "repos/$R/collaborators" --jq '.[].login' 2>/dev/null)
  if [[ -n "$collabs" ]]; then
    pick=$(printf '%s\n' "$collabs" \
      | _gh_fzf prs --multi --border-label=" 👤 request reviewers " \
          --header="tab toggles   enter requests   esc back")
  else
    pick=$(_gh_input "Reviewer username(s), comma-separated:")
  fi
  [[ -z "$pick" ]] && return
  joined=$(printf '%s\n' "$pick" | paste -sd,)
  gh pr edit "$num" --add-reviewer "$joined" && { echo "  ✅ requested: $joined"; sleep 1; }
}

_ghw_pr_edit() {
  local num="$1" field
  field=$(printf '%s\n' "Title" "Body (description)" \
    | _gh_menu "Edit #$num" --border-label=" ✏  edit ")
  [[ -z "$field" ]] && return
  case "$field" in
    Title)
      local current new
      current=$(gh pr view "$num" --json title -q .title)
      new=$(_gh_input "Title:" "$current")
      [[ -n "$new" && "$new" != "$current" ]] && gh pr edit "$num" --title "$new" && { echo "  ✅ title updated"; sleep 1; } ;;
    *Body*)
      local tmpfile
      tmpfile=$(mktemp "${TMPDIR:-/tmp}/pr-body-XXXXXX.md")
      gh pr view "$num" --json body -q .body > "$tmpfile"
      ${EDITOR:-vi} "$tmpfile"
      gh pr edit "$num" --body-file "$tmpfile" && { echo "  ✅ description updated"; sleep 1; }
      rm -f "$tmpfile" ;;
  esac
}

# ── branches ──

_ghw_branch_checkout() {
  local name="$1"
  [[ -z "$name" || "$name" == none ]] && return 0
  echo ""
  git checkout "$name" 2>&1 && echo "  ✅ on $name" || echo "  ❌ checkout failed"
  sleep 1.2
}

_ghw_branch_delete() {
  local name="$1" isdef="$2"
  [[ -z "$name" || "$name" == none ]] && return 0
  if (( isdef )); then echo ""; echo "  ❌ that is the default branch"; sleep 1.5; return; fi
  _gh_confirm "Delete remote branch '$name'?" "Delete it" "Keep it" || return 0
  echo ""
  git push origin --delete "$name" 2>&1 && echo "  ✅ deleted origin/$name" || echo "  ❌ delete failed"
  sleep 1.5
}

_ghw_branch_menu() {
  local name="$1" protected="$2" isdef="$3" iscur="$4" action
  [[ -z "$name" || "$name" == none ]] && return 0
  while true; do
    action=$(printf '%s\n' \
      "📥 Checkout" \
      "🛡  Effective rules" \
      "📜 Rulesets" \
      "⭐ Set as default branch" \
      "🗑  Delete remote branch" \
      "⚠️  Legacy classic protection" \
      "🌐 Open in browser" \
      | FZF_MENU_HELP="$_GH_D/help/branches" _gh_menu "$name" \
          --border-label=" 🌿 $name " \
          --preview="bash '$_GH_W' pv-branch '$name' '$protected' '$isdef' '$iscur'" "${_GH_PREVIEW[@]}")
    [[ -z "$action" ]] && return 0
    case "$action" in
      *Checkout*)  _ghw_branch_checkout "$name"; iscur=1 ;;
      *"Effective rules"*)
        echo ""; echo "━━━ Effective rules: $name ━━━"; echo ""
        _ghbranch_effective "$R" "$name"; _gh_pause ;;
      *Rulesets*)  _ghbranch_rulesets "$R" ;;
      *default*)
        _gh_confirm "Make '$name' the default branch?" "Yes, set default" "No" || continue
        gh repo edit --default-branch "$name" 2>/dev/null \
          && { echo "  ✅ default branch is now $name"; isdef=1; } || echo "  ❌ failed — needs admin"
        sleep 1.5 ;;
      *Delete*)    _ghw_branch_delete "$name" "$isdef"; return 0 ;;
      *Legacy*)    _ghbranch_legacy "$R" "$name" ;;
      *browser*)   _ghw_open_branch "$name" ;;
    esac
  done
}

_ghw_rulesets() { _ghbranch_rulesets "$R"; }

# ── secrets ──

# Set (or replace) a secret. With arguments it pre-fills scope and name —
# enter on an existing secret is "set it again", which is the only way to
# change one. The value goes straight to `gh secret set`, which reads it
# hidden from the tty; it never passes through a variable here.
_ghw_secret_set() {
  local scope="${1:-}" env="${2:-}" name="${3:-}"
  [[ "$scope" == none ]] && scope=""
  if [[ -z "$scope" ]]; then
    local pick
    pick=$(printf '%s\n' "🔑 Repository secret" "🌍 Environment secret" \
      | _gh_menu "Where does it live?" --border-label=" 🔑 new secret ")
    [[ -z "$pick" ]] && return 0
    case "$pick" in *Repository*) scope="repo" ;; *) scope="env" ;; esac
  fi
  if [[ "$scope" == env && -z "$env" ]]; then
    env=$(gh api "repos/$R/environments" --jq '.environments[].name' 2>/dev/null \
      | _gh_fzf envs --border-label=" 🌍 which environment? " --header="enter select   esc back")
    [[ -z "$env" ]] && return 0
  fi
  if [[ -z "$name" ]]; then
    name=$(_gh_input "Secret name:")
    [[ -z "$name" ]] && return 0
  fi
  name=$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')
  echo ""
  echo "  🔑 $name${env:+  (environment: $env)}"
  echo "  Paste the value — input is hidden, enter to save:"
  if [[ "$scope" == env ]]; then gh secret set "$name" --env "$env"; else gh secret set "$name"; fi \
    && echo "  ✅ saved $name" || echo "  ❌ not saved"
  sleep 1.2
}

_ghw_secret_delete() {
  local scope="$1" env="$2" name="$3"
  [[ "$scope" == none || -z "$name" ]] && return 0
  _gh_confirm "Delete secret $name${env:+ from $env}? This cannot be undone." "Delete it" "Keep it" || return 0
  echo ""
  if [[ "$scope" == env ]]; then gh secret delete "$name" --env "$env"; else gh secret delete "$name"; fi \
    && echo "  ✅ deleted $name" || echo "  ❌ delete failed"
  sleep 1.2
}

