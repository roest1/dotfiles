}

_ghw_env_delete() {
  local name="$1"
  [[ -z "$name" || "$name" == none ]] && return 0
  _gh_confirm "Delete environment '$name' and every secret in it?" "Delete it" "Keep it" || return 0
  echo ""
  gh api -X DELETE "repos/$R/environments/$name" --silent 2>/dev/null \
    && echo "  ✅ deleted $name" || echo "  ❌ failed — needs admin"
